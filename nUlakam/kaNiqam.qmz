// __nUlakam/kaNiqam.qmz — கணிதம் (math) helpers__
//
// __Rounding, floor and ceiling come from the host because they need the__
// __decimal representation itself. Everything below is built from those.__

// __முழுமதிப்பு(எண்) — absolute value__
செயல் முழுமதிப்பு(மதிப்பு) {
    (மதிப்பு < 0) எனில் { திரும்பு 0 - மதிப்பு; }
    திரும்பு மதிப்பு;
}

// சிறியது(அ, ஆ) / பெரியது(அ, ஆ)
செயல் சிறியது(அ, ஆ) {
    (அ < ஆ) எனில் { திரும்பு அ; }
    திரும்பு ஆ;
}

செயல் பெரியது(அ, ஆ) {
    (அ > ஆ) எனில் { திரும்பு அ; }
    திரும்பு ஆ;
}

// __கூட்டு(அணி) — sum of an array__
செயல் கூட்டு(பட்டியல்) {
    மொத்தம் = 0;
    ஒவ்வொரு உறுப்பு இல் பட்டியல் {
        மொத்தம் = மொத்தம் + உறுப்பு;
    }
    திரும்பு மொத்தம்;
}

// __சராசரி(அணி) — mean; an empty array is an error, not a division by zero__
செயல் சராசரி(பட்டியல்) {
    எண்ணிக்கை = நீளம்(பட்டியல்);
    (எண்ணிக்கை == 0) எனில் {
        திரும்பு தவறு("காலி அணியின் சராசரி இல்லை  (no average of an empty array)");
    }
    திரும்பு சரி(கூட்டு(பட்டியல்) / எண்ணிக்கை);
}

// மிகச்சிறியது(அணி) / மிகப்பெரியது(அணி)
செயல் மிகச்சிறியது(பட்டியல்) {
    (நீளம்(பட்டியல்) == 0) எனில் {
        திரும்பு தவறு("காலி அணி  (empty array)");
    }
    விடை = பட்டியல்[0];
    ஒவ்வொரு உறுப்பு இல் பட்டியல் {
        (உறுப்பு < விடை) எனில் { விடை = உறுப்பு; }
    }
    திரும்பு சரி(விடை);
}

செயல் மிகப்பெரியது(பட்டியல்) {
    (நீளம்(பட்டியல்) == 0) எனில் {
        திரும்பு தவறு("காலி அணி  (empty array)");
    }
    விடை = பட்டியல்[0];
    ஒவ்வொரு உறுப்பு இல் பட்டியல் {
        (உறுப்பு > விடை) எனில் { விடை = உறுப்பு; }
    }
    திரும்பு சரி(விடை);
}

// __சதவீதம்(தொகை, விகிதம்) — விகிதம் percent of தொகை, rounded to paise__
செயல் சதவீதம்(தொகை, விகிதம்) {
    திரும்பு வட்டமிடு(தொகை * விகிதம் / 100, 2);
}

// __முழு_எண்ணா(மதிப்பு) — is this a whole number?__
செயல் முழு_எண்ணா(மதிப்பு) {
    திரும்பு தரை(மதிப்பு) == மதிப்பு;
}

// __மீதி(எண், வகுப்பான்) — the remainder, since there is no % operator__
//
// __Written here rather than added to the host: it follows from தரை and the__
// __arithmetic the language already has, so Layer 0 gains nothing by owning it.__
செயல் மீதி(எண்_மதிப்பு, வகுப்பான்) {
    (வகுப்பான் == 0) எனில் { திரும்பு 0; }
    திரும்பு எண்_மதிப்பு - தரை(எண்_மதிப்பு / வகுப்பான்) * வகுப்பான்;
}

// __வர்க்கமூலம்(மதிப்பு) — the square root, by Newton's method__
//
// __The host has no square root, no power and no exponential, so this is built__
// __from the arithmetic the language has — the same reason மீதி is written here__
// __rather than asked of Layer 0.__
//
// __Newton's method doubles the correct digits each pass, so a dozen iterations__
// __is far more than a Decimal can hold; the loop stops when the estimate stops__
// __moving and the bound of forty is only there so that a pathological input__
// __cannot spin for ever.__
//
// __A negative input is a தவறு rather than nil or zero. Taking the root of a__
// __negative variance is not a rounding problem, it is a sign error upstream,__
// __and answering zero would hide it inside a confidence figure that looks__
// __perfectly reasonable.__
செயல் வர்க்கமூலம்(மதிப்பு) {
    (மதிப்பு < 0) எனில் {
        திரும்பு தவறு("எதிர்மறை எண்ணின் வர்க்கமூலம் இல்லை  "
                       & "(no square root of a negative number)");
    }
    (மதிப்பு == 0) எனில் { திரும்பு சரி(0); }

    கணிப்பு = மதிப்பு;
    (கணிப்பு < 1) எனில் { கணிப்பு = 1; }

    சுற்றெண் = 0;
    (சுற்றெண் < 40) சுற்று {
        அடுத்த_கணிப்பு = (கணிப்பு + மதிப்பு / கணிப்பு) / 2;
        (முழுமதிப்பு(அடுத்த_கணிப்பு - கணிப்பு) < 0.0000000001) எனில் {
            திரும்பு சரி(அடுத்த_கணிப்பு);
        }
        கணிப்பு = அடுத்த_கணிப்பு;
        சுற்றெண் = சுற்றெண் + 1;
    }
    திரும்பு சரி(கணிப்பு);
}
