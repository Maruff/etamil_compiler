// nUlakam/col.qmz — சரம் (string) helpers
//
// Written in eTamil, not Rust. The only primitives borrowed from the host
// are நீளம், சொல்லாக்கு and indexing; everything here is built from those.

// எழுத்து(சரம், எழுத்திடம்) — the letter at a position, or "" past either end.
//
// This was once necessary: மற்றும் evaluated both sides, so a guard like
// `(இ < நீளம்(சரம்) மற்றும் சரம்[இ] == " ")` indexed out of bounds on the very
// step that failed the first test. மற்றும் short-circuits now, so that guard
// is safe to write directly. This stays because "the letter there, or nothing"
// is worth saying in one word, not because indexing needs guarding.
//
// The parameter is எழுத்திடம் rather than the plainer இடம் because that word
// is the SQL LEFT keyword and is hard reserved — it cannot be a name at all.
செயல் எழுத்து(சரம், எழுத்திடம்) {
    (எழுத்திடம் < 0) எனில் { திரும்பு ""; }
    (எழுத்திடம் >= நீளம்(சரம்)) எனில் { திரும்பு ""; }
    திரும்பு சரம்[எழுத்திடம்];
}

// துண்டு(சரம், தொடக்கம், அளவு) — substring
செயல் துண்டு(சரம், தொடக்கம், அளவு) {
    விடை = "";
    எண்ணி = தொடக்கம்;
    முடிவு = தொடக்கம் + அளவு;
    மொத்தம் = நீளம்(சரம்);
    (எண்ணி < முடிவு மற்றும் எண்ணி < மொத்தம்) சுற்று {
        விடை = விடை & சரம்[எண்ணி];
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு விடை;
}

// தேடு(சரம், தேடல்) — position of the first match, or -1
செயல் தேடு(சரம், தேடல்) {
    மொத்தம் = நீளம்(சரம்);
    அளவு = நீளம்(தேடல்);
    (அளவு == 0) எனில் { திரும்பு 0; }
    எண்ணி = 0;
    (எண்ணி + அளவு <= மொத்தம்) சுற்று {
        (துண்டு(சரம், எண்ணி, அளவு) == தேடல்) எனில் {
            திரும்பு எண்ணி;
        }
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு 0 - 1;
}

// கொண்டுள்ளதா(சரம், தேடல்) — does it contain?
செயல் கொண்டுள்ளதா(சரம், தேடல்) {
    திரும்பு தேடு(சரம், தேடல்) >= 0;
}

// தொடங்குகிறதா(சரம், முன்னொட்டு)
செயல் தொடங்குகிறதா(சரம், முன்னொட்டு) {
    அளவு = நீளம்(முன்னொட்டு);
    (அளவு > நீளம்(சரம்)) எனில் { திரும்பு பொய்; }
    திரும்பு துண்டு(சரம், 0, அளவு) == முன்னொட்டு;
}

// முடிகிறதா(சரம், பின்னொட்டு)
செயல் முடிகிறதா(சரம், பின்னொட்டு) {
    அளவு = நீளம்(பின்னொட்டு);
    மொத்தம் = நீளம்(சரம்);
    (அளவு > மொத்தம்) எனில் { திரும்பு பொய்; }
    திரும்பு துண்டு(சரம், மொத்தம் - அளவு, அளவு) == பின்னொட்டு;
}

// ஒழுங்கு(சரம்) — trim spaces from both ends
//
// Both scans read through எழுத்து. Written as a direct index this crashed on
// "" and on a string of nothing but spaces: the loop guard was correct, but
// மற்றும் evaluates its right side anyway, so the index ran off the end.
செயல் ஒழுங்கு(சரம்) {
    தொடக்கம் = 0;
    (எழுத்து(சரம், தொடக்கம்) == " ") சுற்று {
        தொடக்கம் = தொடக்கம் + 1;
    }
    முடிவு = நீளம்(சரம்);
    (முடிவு > தொடக்கம் மற்றும் எழுத்து(சரம், முடிவு - 1) == " ") சுற்று {
        முடிவு = முடிவு - 1;
    }
    திரும்பு துண்டு(சரம், தொடக்கம், முடிவு - தொடக்கம்);
}

// பிரி(சரம், பிரிப்பான்) and ஒன்றிணை(அணி, இணைப்பான்) are host builtins now.
//
// They were written here, in eTamil, like everything else in this file. Both
// walked the string a letter at a time, and each read re-segmented the whole
// string into letters, so splitting a document cost O(n²) segmentations —
// 14 seconds over 8 KB, and 400 KB never finished. The host does one
// segmentation pass and then a byte search. The letter-boundary rule is
// unchanged, so the pieces are the same pieces; only the cost differs.
//
// A function defined here would shadow the builtin, so they are gone rather
// than delegating. See மாற்று too, which is new and has no version here.

// திரும்பச்செய்(சரம், எண்ணிக்கை) — repeat
செயல் திரும்பச்செய்(சரம், எண்ணிக்கை) {
    விடை = "";
    எண்ணி = 0;
    (எண்ணி < எண்ணிக்கை) சுற்று {
        விடை = விடை & சரம்;
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு விடை;
}

// இடமிருந்து_நிரப்பு(சரம், அகலம், நிரப்பி) — left pad
செயல் இடமிருந்து_நிரப்பு(சரம், அகலம், நிரப்பி) {
    விடை = சொல்லாக்கு(சரம்);
    (நீளம்(விடை) < அகலம்) சுற்று {
        விடை = நிரப்பி & விடை;
    }
    திரும்பு விடை;
}
