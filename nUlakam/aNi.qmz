// __nUlakam/aNi.qmz — அணி (array) helpers__
//
// __Note: the language has no first-class functions yet, so there is no map or__
// __filter here. When function values arrive these become one-liners.__

// __உள்ளதா(அணி, மதிப்பு) — membership__
செயல் உள்ளதா(பட்டியல், தேடல்) {
    ஒவ்வொரு உறுப்பு இல் பட்டியல் {
        (உறுப்பு == தேடல்) எனில் { திரும்பு மெய்; }
    }
    திரும்பு பொய்;
}

// __இடம்_காண்(அணி, மதிப்பு) — first position, or -1__
செயல் இடம்_காண்(பட்டியல், தேடல்) {
    எண்ணி = 0;
    மொத்தம் = நீளம்(பட்டியல்);
    (எண்ணி < மொத்தம்) சுற்று {
        (பட்டியல்[எண்ணி] == தேடல்) எனில் { திரும்பு எண்ணி; }
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு 0 - 1;
}

// __தலைகீழ்(அணி) — reversed copy__
செயல் தலைகீழ்(பட்டியல்) {
    விடை = [];
    எண்ணி = நீளம்(பட்டியல்);
    (எண்ணி > 0) சுற்று {
        எண்ணி = எண்ணி - 1;
        விடை = இணை(விடை, பட்டியல்[எண்ணி]);
    }
    திரும்பு விடை;
}

// __வெட்டு(அணி, தொடக்கம், அளவு) — slice__
செயல் வெட்டு(பட்டியல், தொடக்கம், அளவு) {
    விடை = [];
    எண்ணி = தொடக்கம்;
    முடிவு = தொடக்கம் + அளவு;
    மொத்தம் = நீளம்(பட்டியல்);
    (எண்ணி < முடிவு மற்றும் எண்ணி < மொத்தம்) சுற்று {
        விடை = இணை(விடை, பட்டியல்[எண்ணி]);
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு விடை;
}

// __புலம்_எடு(வரிசைகள், புலம்) — pluck one field from every record.__
// __This is the column-from-rows operation a result set needs.__
செயல் புலம்_எடு(வரிசைகள், புலம்) {
    விடை = [];
    ஒவ்வொரு ஒரு_பதிவு இல் வரிசைகள் {
        விடை = இணை(விடை, ஒரு_பதிவு[புலம்]);
    }
    திரும்பு விடை;
}

// காலியா(அணி)
செயல் காலியா(பட்டியல்) {
    திரும்பு நீளம்(பட்டியல்) == 0;
}
