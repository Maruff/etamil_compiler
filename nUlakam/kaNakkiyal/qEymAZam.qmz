// nUlakam/kaNakkiyal/qEymAZam.qmz — தேய்மானம் (depreciation)
//
// Two methods, because Indian accounts need both and they disagree. Straight
// line spreads the cost evenly and is what the Companies Act expects of the
// books. Written-down value takes a percentage of what is left each year and
// is what the Income Tax Act computes on. The same asset is depreciated twice,
// differently, for two readers — that is not a mistake to be reconciled but
// the arrangement.
//
// No useful life and no rate is written here. Schedule II lives and the Income
// Tax block rates are set by statute and amended; they belong in a table, the
// way the asset classification rules do. Everything below takes them as
// arguments.
//
// Rates are a number out of a hundred: 15% is 15, as everywhere else here.
//
// A note on names: தேய்மானம், சொத்து, விலை and செலவு are all keywords, so the
// obvious word for each is unavailable alone. Compounds read a little longer
// and lex as ordinary identifiers.

இறக்கு "../kaNiqam.qmz";

// --- straight line --------------------------------------------------------
//
// நேர்கோட்டு_ஆண்டு(கொள்முதல்_மதிப்பு, எஞ்சிய_மதிப்பு, பயன்_ஆண்டுகள்)
//
// The same amount every year, so what the asset cost is spread over what it is
// used for. A residual value is what you expect to sell it for at the end; it
// is not depreciated, because you expect to get it back.
செயல் நேர்கோட்டு_ஆண்டு(கொள்முதல்_மதிப்பு, எஞ்சிய_மதிப்பு, பயன்_ஆண்டுகள்) {
    (பயன்_ஆண்டுகள் <= 0) எனில் { திரும்பு 0; }
    திரும்பு வட்டமிடு((கொள்முதல்_மதிப்பு - எஞ்சிய_மதிப்பு) / பயன்_ஆண்டுகள், 2);
}

// நேர்கோட்டு_விகிதம்(கொள்முதல்_மதிப்பு, எஞ்சிய_மதிப்பு, பயன்_ஆண்டுகள்)
//
// The same thing as a percentage of cost, which is how Schedule II states it.
செயல் நேர்கோட்டு_விகிதம்(கொள்முதல்_மதிப்பு, எஞ்சிய_மதிப்பு, பயன்_ஆண்டுகள்) {
    (கொள்முதல்_மதிப்பு <= 0 அல்லது பயன்_ஆண்டுகள் <= 0) எனில் { திரும்பு 0; }
    ஆண்டுத்_தொகை = (கொள்முதல்_மதிப்பு - எஞ்சிய_மதிப்பு) / பயன்_ஆண்டுகள்;
    திரும்பு வட்டமிடு(ஆண்டுத்_தொகை * 100 / கொள்முதல்_மதிப்பு, 2);
}

// --- written-down value ---------------------------------------------------
//
// குறையும்_ஆண்டு(திறப்பு_மதிப்பு, ஆண்டு_விகிதம், எஞ்சிய_மதிப்பு)
//
// A percentage of what is left, so the charge falls every year and never quite
// reaches nothing — which is why the residual has to stop it. Without that
// floor an asset depreciates for ever in ever smaller amounts.
செயல் குறையும்_ஆண்டு(திறப்பு_மதிப்பு, ஆண்டு_விகிதம், எஞ்சிய_மதிப்பு) {
    கணக்கிட்டது = வட்டமிடு(சதவீதம்(திறப்பு_மதிப்பு, ஆண்டு_விகிதம்), 2);
    தாழ்வு = திறப்பு_மதிப்பு - எஞ்சிய_மதிப்பு;

    (தாழ்வு <= 0) எனில் { திரும்பு 0; }
    (கணக்கிட்டது > தாழ்வு) எனில் { திரும்பு தாழ்வு; }
    திரும்பு கணக்கிட்டது;
}

// --- part of a year -------------------------------------------------------
//
// பகுதி_ஆண்டு(ஆண்டுத்_தொகை, வைத்திருந்த_நாட்கள், ஆண்டு_நாட்கள்)
//
// An asset bought in August is not depreciated for a full year. The Companies
// Act wants this by days held, which is why the days are passed rather than a
// number of months.
செயல் பகுதி_ஆண்டு(ஆண்டுத்_தொகை, வைத்திருந்த_நாட்கள், ஆண்டு_நாட்கள்) {
    (ஆண்டு_நாட்கள் <= 0) எனில் { திரும்பு 0; }
    (வைத்திருந்த_நாட்கள் >= ஆண்டு_நாட்கள்) எனில் { திரும்பு ஆண்டுத்_தொகை; }
    (வைத்திருந்த_நாட்கள் <= 0) எனில் { திரும்பு 0; }
    திரும்பு வட்டமிடு(ஆண்டுத்_தொகை * வைத்திருந்த_நாட்கள் / ஆண்டு_நாட்கள், 2);
}

// --- the schedule ---------------------------------------------------------
//
// நேர்கோட்டு_அட்டவணை(கொள்முதல்_மதிப்பு, எஞ்சிய_மதிப்பு, பயன்_ஆண்டுகள்)
//
// One record per year: {ஆண்டெண், திறப்பு, தேய்வு, முடிவு}. The last year
// takes whatever is left, for the same reason the last instalment of a loan
// does: a charge rounded to the paisa and taken five times does not equal the
// amount to be written off, and a schedule that leaves eight paise on the
// books never closes the asset.
செயல் நேர்கோட்டு_அட்டவணை(கொள்முதல்_மதிப்பு, எஞ்சிய_மதிப்பு, பயன்_ஆண்டுகள்) {
    ஆண்டுத்_தொகை = நேர்கோட்டு_ஆண்டு(கொள்முதல்_மதிப்பு, எஞ்சிய_மதிப்பு, பயன்_ஆண்டுகள்);
    அட்டவணை = [];
    மீதிப்_புத்தகம் = கொள்முதல்_மதிப்பு;
    ஆண்டெண் = 1;

    (ஆண்டெண் <= பயன்_ஆண்டுகள்) சுற்று {
        (ஆண்டெண் == பயன்_ஆண்டுகள்) எனில் {
            இந்த_ஆண்டு = மீதிப்_புத்தகம் - எஞ்சிய_மதிப்பு;
        }
        இன்றேல் {
            இந்த_ஆண்டு = ஆண்டுத்_தொகை;
        }

        முடிவு_மதிப்பு = வட்டமிடு(மீதிப்_புத்தகம் - இந்த_ஆண்டு, 2);
        அட்டவணை = இணை(அட்டவணை, {"ஆண்டெண்": ஆண்டெண்,
                                  "திறப்பு": மீதிப்_புத்தகம்,
                                  "தேய்வு": இந்த_ஆண்டு,
                                  "முடிவு": முடிவு_மதிப்பு});
        மீதிப்_புத்தகம் = முடிவு_மதிப்பு;
        ஆண்டெண் = ஆண்டெண் + 1;
    }
    திரும்பு அட்டவணை;
}

// குறையும்_அட்டவணை(கொள்முதல்_மதிப்பு, ஆண்டு_விகிதம், எஞ்சிய_மதிப்பு, எத்தனை_ஆண்டுகள்)
செயல் குறையும்_அட்டவணை(கொள்முதல்_மதிப்பு, ஆண்டு_விகிதம், எஞ்சிய_மதிப்பு, எத்தனை_ஆண்டுகள்) {
    அட்டவணை = [];
    மீதிப்_புத்தகம் = கொள்முதல்_மதிப்பு;
    ஆண்டெண் = 1;

    (ஆண்டெண் <= எத்தனை_ஆண்டுகள்) சுற்று {
        இந்த_ஆண்டு = குறையும்_ஆண்டு(மீதிப்_புத்தகம், ஆண்டு_விகிதம், எஞ்சிய_மதிப்பு);
        முடிவு_மதிப்பு = வட்டமிடு(மீதிப்_புத்தகம் - இந்த_ஆண்டு, 2);
        அட்டவணை = இணை(அட்டவணை, {"ஆண்டெண்": ஆண்டெண்,
                                  "திறப்பு": மீதிப்_புத்தகம்,
                                  "தேய்வு": இந்த_ஆண்டு,
                                  "முடிவு": முடிவு_மதிப்பு});
        மீதிப்_புத்தகம் = முடிவு_மதிப்பு;
        ஆண்டெண் = ஆண்டெண் + 1;
    }
    திரும்பு அட்டவணை;
}

// மொத்தத்_தேய்வு(அட்டவணை) — everything written off across the schedule
செயல் மொத்தத்_தேய்வு(அட்டவணை) {
    கூட்டல் = 0;
    ஒவ்வொரு ஆண்டுப்_பதிவு இல் அட்டவணை {
        கூட்டல் = கூட்டல் + ஆண்டுப்_பதிவு["தேய்வு"];
    }
    திரும்பு வட்டமிடு(கூட்டல், 2);
}

// --- a block of assets ----------------------------------------------------
//
// தொகுதி_தேய்வு(திறப்பு_மதிப்பு, சேர்த்தவை, விற்றவை, ஆண்டு_விகிதம்,
//                 குறைந்த_நாட்கள்_சேர்ப்பு, பாதி_விகித_எல்லை)
//
// Income tax depreciates a block, not an asset: everything at one rate is
// pooled, purchases are added, sale proceeds are taken out, and the rate
// applies to what is left. An individual asset has no written-down value of
// its own inside a block.
//
// Something bought late in the year gets half the rate. The threshold that
// decides "late" is a statutory number, so it is a parameter — pass the one in
// force rather than trusting a default written here.
//
// குறைந்த_நாட்கள்_சேர்ப்பு is what was added while used for fewer days than
// the threshold; சேர்த்தவை is everything else added.
செயல் தொகுதி_தேய்வு(திறப்பு_மதிப்பு, சேர்த்தவை, விற்றவை, ஆண்டு_விகிதம்,
                     குறைந்த_நாட்கள்_சேர்ப்பு) {
    முழு_விகிதப்_பகுதி = திறப்பு_மதிப்பு + சேர்த்தவை - விற்றவை;

    // Sales can empty a block, and a negative base is not depreciated — it is
    // a balancing charge, which is a different computation and not this one.
    (முழு_விகிதப்_பகுதி < 0) எனில் { முழு_விகிதப்_பகுதி = 0; }

    முழு = வட்டமிடு(சதவீதம்(முழு_விகிதப்_பகுதி, ஆண்டு_விகிதம்), 2);
    பாதி = வட்டமிடு(சதவீதம்(குறைந்த_நாட்கள்_சேர்ப்பு, ஆண்டு_விகிதம்) / 2, 2);

    திரும்பு {"முழு_விகிதம்": முழு,
              "பாதி_விகிதம்": பாதி,
              "மொத்தம்": வட்டமிடு(முழு + பாதி, 2),
              "இறுதி_மதிப்பு": வட்டமிடு(முழு_விகிதப்_பகுதி + குறைந்த_நாட்கள்_சேர்ப்பு
                                          - முழு - பாதி, 2)};
}
