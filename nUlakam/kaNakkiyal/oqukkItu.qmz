// nUlakam/kaNakkiyal/oqukkItu.qmz — ஒதுக்கீடு (assignment / clearing)
//
// A receipt is assigned against the invoices it settles. Until it is, an
// invoice is outstanding for its full amount. This is what gives "நிலுவை"
// a meaning, and everything about ageing depends on it.
//
// Assignments are values in a list, like postings: assigning returns a new
// list rather than editing the old one.

இறக்கு "pErEtu.qmz";
இறக்கு "kAlam.qmz";
இறக்கு "../kaNiqam.qmz";

// ஒதுக்கீடு_ஆக்கு(மூல_எண், இலக்கு_எண், தொகை)
//   மூல_எண்   — the clearing transaction (a receipt or payment)
//   இலக்கு_எண் — the transaction being cleared (an invoice or bill)
செயல் ஒதுக்கீடு_ஆக்கு(மூல_எண், இலக்கு_எண், தொகை_மதிப்பு) {
    திரும்பு {
        மூல_எண்: மூல_எண்,
        இலக்கு_எண்: இலக்கு_எண்,
        தொகை_மதிப்பு: தொகை_மதிப்பு
    };
}

// ஒதுக்கப்பட்ட_மொத்தம்(ஒதுக்கீடுகள், பரிவர்த்தனை_எண்)
// How much has been cleared against a transaction so far.
செயல் ஒதுக்கப்பட்ட_மொத்தம்(ஒதுக்கீடுகள், பரிவர்த்தனை_எண்) {
    மொத்தம் = 0;
    ஒவ்வொரு ஒன்று இல் ஒதுக்கீடுகள் {
        (ஒன்று.இலக்கு_எண் == பரிவர்த்தனை_எண்) எனில் {
            மொத்தம் = மொத்தம் + ஒன்று.தொகை_மதிப்பு;
        }
    }
    திரும்பு மொத்தம்;
}

// பயன்படுத்தப்பட்டது(ஒதுக்கீடுகள், மூல_எண்)
// How much of a receipt has already been spread over invoices.
செயல் பயன்படுத்தப்பட்டது(ஒதுக்கீடுகள், மூல_எண்) {
    மொத்தம் = 0;
    ஒவ்வொரு ஒன்று இல் ஒதுக்கீடுகள் {
        (ஒன்று.மூல_எண் == மூல_எண்) எனில் {
            மொத்தம் = மொத்தம் + ஒன்று.தொகை_மதிப்பு;
        }
    }
    திரும்பு மொத்தம்;
}

// நிலுவைத்_தொகை(பேரேடு, ஒதுக்கீடுகள், பரிவர்த்தனை_எண், கணக்கு, வகை)
// What is still owed on one transaction.
செயல் நிலுவைத்_தொகை(பேரேடு, ஒதுக்கீடுகள், பரிவர்த்தனை_எண்,
                      கணக்கு_குறி, கணக்கு_வகை) {
    மொத்தம் = பரிவர்த்தனை_தொகை(பேரேடு, பரிவர்த்தனை_எண், கணக்கு_குறி, கணக்கு_வகை);
    திரும்பு மொத்தம் - ஒதுக்கப்பட்ட_மொத்தம்(ஒதுக்கீடுகள், பரிவர்த்தனை_எண்);
}

// ஒதுக்கு(...) — clear one transaction against another, or refuse
//
// Two things are checked, and both are real accounting errors rather than
// programming mistakes: you cannot clear more than the invoice is worth, and
// you cannot spread a receipt further than the receipt itself.
செயல் ஒதுக்கு(ஒதுக்கீடுகள், பேரேடு, மூல_எண், இலக்கு_எண்,
               தொகை_மதிப்பு, கணக்கு_குறி, கணக்கு_வகை) {
    (தொகை_மதிப்பு <= 0) எனில் {
        திரும்பு தவறு("ஒதுக்கீடு நேர்மறையாக இருக்க வேண்டும்");
    }

    மீதம் = நிலுவைத்_தொகை(பேரேடு, ஒதுக்கீடுகள், இலக்கு_எண்,
                            கணக்கு_குறி, கணக்கு_வகை);
    (தொகை_மதிப்பு > மீதம்) எனில் {
        திரும்பு தவறு("நிலுவைக்கு மேல் ஒதுக்க முடியாது: " & இலக்கு_எண்
                      & " நிலுவை " & மீதம் & ", கேட்டது " & தொகை_மதிப்பு);
    }

    மூலத்_தொகை = முழுமதிப்பு(
        பரிவர்த்தனை_தொகை(பேரேடு, மூல_எண், கணக்கு_குறி, கணக்கு_வகை));
    ஏற்கனவே = பயன்படுத்தப்பட்டது(ஒதுக்கீடுகள், மூல_எண்);
    (ஏற்கனவே + தொகை_மதிப்பு > மூலத்_தொகை) எனில் {
        திரும்பு தவறு("பணத்திற்கு மேல் ஒதுக்க முடியாது: " & மூல_எண்
                      & " தொகை " & மூலத்_தொகை
                      & ", ஏற்கனவே " & ஏற்கனவே);
    }

    திரும்பு சரி(இணை(ஒதுக்கீடுகள்,
        ஒதுக்கீடு_ஆக்கு(மூல_எண், இலக்கு_எண், தொகை_மதிப்பு)));
}

// நிலுவைப்_பட்டியல்(...) — every transaction on an account still owing
செயல் நிலுவைப்_பட்டியல்(பேரேடு, ஒதுக்கீடுகள், கணக்கு_குறி, கணக்கு_வகை) {
    விடை = [];
    ஒவ்வொரு ஒரு_எண் இல் பரிவர்த்தனை_எண்கள்(பேரேடு, கணக்கு_குறி) {
        மீதம் = நிலுவைத்_தொகை(பேரேடு, ஒதுக்கீடுகள், ஒரு_எண், கணக்கு_குறி, கணக்கு_வகை);
        (மீதம் > 0) எனில் {
            நாள் = மதிப்பு(பரிவர்த்தனை_நாள்(பேரேடு, ஒரு_எண்));
            விடை = இணை(விடை, {
                பரிவர்த்தனை_எண்: ஒரு_எண்,
                நாள்: நாள்,
                நிலுவை: மீதம்
            });
        }
    }
    திரும்பு விடை;
}

// வயது_அட்டவணை(...) — an ageing schedule
//
// Buckets follow the usual receivables convention. இன்று is passed in
// rather than read from the clock so a report can be reproduced.
செயல் வயது_அட்டவணை(பேரேடு, ஒதுக்கீடுகள், கணக்கு_குறி, கணக்கு_வகை, அன்றைய_நாள்) {
    நடப்பு = 0;
    முப்பது = 0;
    அறுபது = 0;
    தொண்ணூறு = 0;
    மேலும் = 0;

    ஒவ்வொரு உருப்படி இல் நிலுவைப்_பட்டியல்(பேரேடு, ஒதுக்கீடுகள்,
                                              கணக்கு_குறி, கணக்கு_வகை) {
        வயது = நாள்_வேறுபாடு(உருப்படி.நாள், அன்றைய_நாள்);
        (வயது <= 30) எனில் { நடப்பு = நடப்பு + உருப்படி.நிலுவை; }
        இன்றேல் {
            (வயது <= 60) எனில் { முப்பது = முப்பது + உருப்படி.நிலுவை; }
            இன்றேல் {
                (வயது <= 90) எனில் { அறுபது = அறுபது + உருப்படி.நிலுவை; }
                இன்றேல் {
                    (வயது <= 120) எனில் { தொண்ணூறு = தொண்ணூறு + உருப்படி.நிலுவை; }
                    இன்றேல் { மேலும் = மேலும் + உருப்படி.நிலுவை; }
                }
            }
        }
    }

    திரும்பு {
        நடப்பு: நடப்பு,
        முப்பது: முப்பது,
        அறுபது: அறுபது,
        தொண்ணூறு: தொண்ணூறு,
        மேலும்: மேலும்,
        மொத்தம்: நடப்பு + முப்பது + அறுபது + தொண்ணூறு + மேலும்
    };
}

செயல் வயது_அட்டவணை_அச்சிடு(அட்டவணை) {
    அச்சு "வயது அட்டவணை";
    அச்சு "  நடப்பு (0-30)   : " & அட்டவணை.நடப்பு;
    அச்சு "  31-60           : " & அட்டவணை.முப்பது;
    அச்சு "  61-90           : " & அட்டவணை.அறுபது;
    அச்சு "  91-120          : " & அட்டவணை.தொண்ணூறு;
    அச்சு "  120 மேல்        : " & அட்டவணை.மேலும்;
    அச்சு "  மொத்த நிலுவை    : " & அட்டவணை.மொத்தம்;
}
