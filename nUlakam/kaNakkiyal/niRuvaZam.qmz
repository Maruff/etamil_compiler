// nUlakam/kaNakkiyal/niRuvaZam.qmz — நிறுவனம் and நாணயம்
//
// Multiple companies in one ledger, and transactions in a currency other
// than the one the books are kept in.
//
// Entities are a stamp on each posting rather than separate ledgers, so a
// group can be consolidated by simply not filtering.

இறக்கு "pErEtu.qmz";
இறக்கு "../kaNiqam.qmz";

// --- நிறுவனம் (entity) ---

// நிறுவனம்_ஆக்கு(குறி, பெயர், அறிக்கை_நாணயம்)
செயல் நிறுவனம்_ஆக்கு(குறி, பெயர், அறிக்கை_நாணயம்) {
    திரும்பு {
        குறி: குறி,
        பெயர்: பெயர்,
        அறிக்கை_நாணயம்: அறிக்கை_நாணயம்
    };
}

// நிறுவனத்துடன்_பதிவிடு(பேரேடு, பரிவர்த்தனை, நிறுவனக்_குறி)
//
// Posts exactly as பதிவிடு does — the same balance check — then stamps each
// line with the entity it belongs to.
செயல் நிறுவனத்துடன்_பதிவிடு(பேரேடு, பரிவர்த்தனை, நிறுவனக்_குறி) {
    முன்_நீளம் = நீளம்(பேரேடு);
    விளைவு = பதிவிடு(பேரேடு, பரிவர்த்தனை);
    புதிய = விளைவு?;

    முடிவு = [];
    எண்ணி = 0;
    ஒவ்வொரு பதிவு இல் புதிய {
        (எண்ணி < முன்_நீளம்) எனில் {
            முடிவு = இணை(முடிவு, பதிவு);
        }
        இன்றேல் {
            பதிவு.நிறுவனக்_குறி = நிறுவனக்_குறி;
            முடிவு = இணை(முடிவு, பதிவு);
        }
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு சரி(முடிவு);
}

// நிறுவன_வடிகட்டு(பேரேடு, நிறுவனக்_குறி) — one company's books
செயல் நிறுவன_வடிகட்டு(பேரேடு, நிறுவனக்_குறி) {
    விடை = [];
    ஒவ்வொரு பதிவு இல் பேரேடு {
        (பதிவு.நிறுவனக்_குறி == நிறுவனக்_குறி) எனில் {
            விடை = இணை(விடை, பதிவு);
        }
    }
    திரும்பு விடை;
}

// --- நாணயம் (currency) ---

// நாணயம்_ஆக்கு(குறி, பெயர், சின்னம்)
செயல் நாணயம்_ஆக்கு(குறி, பெயர், சின்னம்) {
    திரும்பு {குறி: குறி, பெயர்: பெயர், சின்னம்: சின்னம்};
}

// மாற்று_விகிதம்_ஆக்கு(நாணயக்_குறி, நாள், விகிதம்)
// விகிதம் is units of the reporting currency per one unit of the foreign one.
செயல் மாற்று_விகிதம்_ஆக்கு(நாணயக்_குறி, நாள், விகிதம்) {
    திரும்பு {நாணயக்_குறி: நாணயக்_குறி, நாள்: நாள், விகிதம்: விகிதம்};
}

// அடிப்படைக்கு_மாற்று(தொகை, விகிதம்) — foreign amount into reporting currency
செயல் அடிப்படைக்கு_மாற்று(தொகை_மதிப்பு, விகிதம்) {
    திரும்பு வட்டமிடு(தொகை_மதிப்பு * விகிதம், 2);
}

// --- அன்னிய வேறுபாடு (forex difference) ---
//
// An invoice raised at one rate and settled at another leaves a difference
// that is neither revenue nor a change in what the customer owed. IFRS puts
// it to exchange gain or loss, and it must be posted or the books will not
// balance in the reporting currency.

// வேறுபாட்டுத்_தொகை(அன்னியத்_தொகை, பழைய_விகிதம், புதிய_விகிதம்)
செயல் வேறுபாட்டுத்_தொகை(அன்னியத்_தொகை, பழைய_விகிதம், புதிய_விகிதம்) {
    திரும்பு வட்டமிடு(அன்னியத்_தொகை * (புதிய_விகிதம் - பழைய_விகிதம்), 2);
}

// அன்னிய_வேறுபாடு(...) — the transaction that records it
//
// A positive difference on a receivable is a gain: the customer's debt is
// worth more in our currency than when it was raised.
செயல் அன்னிய_வேறுபாடு(பரிவர்த்தனை_எண், நாள், விவரம்,
                         வாடிக்கையாளர்_கணக்கு, லாப_கணக்கு, இழப்பு_கணக்கு,
                         வேறுபாடு) {
    (வேறுபாடு == 0) எனில் {
        திரும்பு தவறு("வேறுபாடு இல்லை  (no exchange difference to post)");
    }
    (வேறுபாடு > 0) எனில் {
        திரும்பு சரி(பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், [
            பற்று_வரிசை(வாடிக்கையாளர்_கணக்கு, வேறுபாடு),
            வரவு_வரிசை(லாப_கணக்கு, வேறுபாடு)
        ]));
    }
    இழப்பு = 0 - வேறுபாடு;
    திரும்பு சரி(பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், [
        பற்று_வரிசை(இழப்பு_கணக்கு, இழப்பு),
        வரவு_வரிசை(வாடிக்கையாளர்_கணக்கு, இழப்பு)
    ]));
}
