// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Mohammed Maruff (Esan Maruff) <esan@etamil.in>
// வருவாய்_சோதனை — tests for revenue recognition, written in eTamil
//
// Run it like any other program:  etamil --vm nUlakam/varuvAy/varuvAy_cOqaZY.qmz
// It exits non-zero if anything fails, so it works as a CI step.
//
// One contract runs through most of the file: a ₹12,000 job expected to cost
// ₹9,000, of which ₹3,000 is a machine bought in and not yet installed. It is
// re-estimated at ₹20,000 part way through, which turns it from profitable to
// onerous, and the tests follow that through progress, revenue, the cumulative
// catch-up and the provision. The figures are small so every step divides.

இறக்கு "../cOqaZY.qmz";
இறக்கு "../kaNiqam.qmz";
இறக்கு "oppanqam.qmz";
இறக்கு "muZZERRam.qmz";
இறக்கு "iruppukaL.qmz";
இறக்கு "oppanqac_celavu.qmz";

ஓட்டம் = சோதனை_தொடக்கம்("வருவாய் — Ind AS 115");

// =========================================================================
// படி 1 — is there a contract at all
// =========================================================================

ஓட்டம் = உறுதிசெய்(ஓட்டம், ஒப்பந்தம்_உள்ளதா(மெய், மெய், மெய், மெய், மெய்),
                  "all five criteria met is a contract");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை ஒப்பந்தம்_உள்ளதா(மெய், மெய், மெய், மெய், பொய்),
                  "collection not probable means there is no contract — "
                  & "nothing is recognised however much work is done");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை ஒப்பந்தம்_உள்ளதா(பொய், மெய், மெய், மெய், மெய்),
                  "and without approval there is none either");

// =========================================================================
// படி 2 — performance obligations
// =========================================================================

ஓட்டம் = உறுதிசெய்(ஓட்டம், தனிக்_கடமையா(மெய், மெய்),
                  "capable of being distinct and separately identifiable");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை தனிக்_கடமையா(மெய், பொய்),
                  "bricks for a wall are capable of being distinct but are "
                  & "not separately identifiable — both conditions are needed");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை தனிக்_கடமையா(பொய், மெய்),
                  "and neither condition works alone");

// =========================================================================
// படி 3 — the transaction price
// =========================================================================

விளைவுகள் = [{"தொகை": 8000, "நிகழ்தகவு": 60},
              {"தொகை": 6000, "நிகழ்தகவு": 40}];

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(மாறும்_எதிர்பார்ப்பு(விளைவுகள்)), 7200,
              "expected value is the probability-weighted amount");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(மிக_வாய்ப்பான_தொகை(விளைவுகள்)), 8000,
              "most likely amount is the single outcome with the highest "
              & "probability — and 7,200 is an amount that cannot occur");

ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(மாறும்_எதிர்பார்ப்பு([{"தொகை": 100,
                                                        "நிகழ்தகவு": 90}])),
                  "probabilities that do not total 100 are refused rather "
                  & "than scaled — an outcome was forgotten");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(மாறும்_எதிர்பார்ப்பு([])),
                  "and an empty list has no expected value");

ஓட்டம் = சமம்(ஓட்டம், கட்டுப்பாட்டுடன்(7200, 50), 3600,
              "the constraint holds back the part that could still reverse");
ஓட்டம் = சமம்(ஓட்டம், கட்டுப்பாட்டுடன்(7200, 100), 7200,
              "nothing constrained is the whole estimate");
ஓட்டம் = சமம்(ஓட்டம், கட்டுப்பாட்டுடன்(7200, 0), 0,
              "and fully constrained is nothing at all");

ஓட்டம் = சமம்(ஓட்டம், பரிமாற்ற_மதிப்பு(100000, 3600, 0, 0), 103600,
              "fixed plus constrained variable");
ஓட்டம் = சமம்(ஓட்டம், பரிமாற்ற_மதிப்பு(100000, 0, 5000, 0), 95000,
              "money payable to the customer reduces the transaction price — "
              & "it is not a marketing expense");
ஓட்டம் = சமம்(ஓட்டம், பரிமாற்ற_மதிப்பு(100000, 0, 0, 4000), 96000,
              "and a significant financing component is stripped out as interest");

// =========================================================================
// படி 4 — allocation
// =========================================================================

கட்டு = [கடமை_ஆக்கு("M", "இயந்திரம்", 6000, பொய்),
          கடமை_ஆக்கு("S", "சேவை", 3000, மெய்),
          கடமை_ஆக்கு("W", "உத்தரவாதம்", 3000, மெய்)];

ஒதுக்கியவை = மதிப்பு(கடமைகளுக்கு_ஒதுக்கு(10000, கட்டு));
ஓட்டம் = சமம்(ஓட்டம், ஒதுக்கியவை[0]["ஒதுக்கிய_மதிப்பு"], 5000,
              "the machine takes half the price, on standalone selling prices");
ஓட்டம் = சமம்(ஓட்டம், ஒதுக்கியவை[1]["ஒதுக்கிய_மதிப்பு"], 2500,
              "and the service a quarter — not the nothing the contract may "
              & "have priced it at");
ஓட்டம் = சமம்(ஓட்டம், ஒதுக்கியதன்_கூட்டல்(ஒதுக்கியவை), 10000,
              "the allocation reconciles to the transaction price");

// The case rounding breaks: a price that does not divide by three.
சமமானவை = [கடமை_ஆக்கு("A", "ஒன்று", 1000, மெய்),
             கடமை_ஆக்கு("B", "இரண்டு", 1000, மெய்),
             கடமை_ஆக்கு("C", "மூன்று", 1000, மெய்)];
மூன்றில் = மதிப்பு(கடமைகளுக்கு_ஒதுக்கு(10000, சமமானவை));
ஓட்டம் = சமம்(ஓட்டம், மூன்றில்[0]["ஒதுக்கிய_மதிப்பு"], 3333.33, "3,333.33");
ஓட்டம் = சமம்(ஓட்டம், மூன்றில்[2]["ஒதுக்கிய_மதிப்பு"], 3333.34,
              "and the last share takes the odd paisa");
ஓட்டம் = சமம்(ஓட்டம், ஒதுக்கியதன்_கூட்டல்(மூன்றில்), 10000,
              "so the three still sum to exactly 10,000 — which rounding each "
              & "share independently would not");

ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(கடமைகளுக்கு_ஒதுக்கு(10000, [])),
                  "there is nothing to allocate to in an empty contract");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(கடமைகளுக்கு_ஒதுக்கு(10000,
                      [கடமை_ஆக்கு("Z", "ஒன்றுமில்லை", 0, மெய்)])),
                  "and no standalone selling prices means no basis to allocate on");

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(எஞ்சிய_முறை(10000, [6000, 3000])), 1000,
              "the residual approach gives the uncertain obligation what is left");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(எஞ்சிய_முறை(10000, [6000, 5000])),
                  "and refuses when the observable prices exhaust the price");

தள்ளுபடியிட்டவை = மதிப்பு(தள்ளுபடியை_ஒதுக்கு(600, கட்டு, ["S", "W"]));
ஓட்டம் = சமம்(ஓட்டம், நீளம்(தள்ளுபடியிட்டவை), 2,
              "evidenced discount reaches only the obligations it belongs to");
ஓட்டம் = சமம்(ஓட்டம், ஒதுக்கியதன்_கூட்டல்(தள்ளுபடியிட்டவை), 600,
              "and still accounts for the whole discount");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(மதிப்பு(தள்ளுபடியை_ஒதுக்கு(600, கட்டு, []))), 3,
              "with no evidence it is spread across all of them, which is "
              & "the default");

// =========================================================================
// படி 5 — over time or at a point in time
// =========================================================================

ஓட்டம் = உறுதிசெய்(ஓட்டம், காலப்போக்கிலா(மெய், பொய், பொய், பொய்),
                  "a service consumed as it is delivered is satisfied over time");
ஓட்டம் = உறுதிசெய்(ஓட்டம், காலப்போக்கிலா(பொய், மெய், பொய், பொய்),
                  "so is work on an asset the customer already controls");
ஓட்டம் = உறுதிசெய்(ஓட்டம், காலப்போக்கிலா(பொய், பொய், மெய், மெய்),
                  "no alternative use *and* an enforceable right to payment");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை காலப்போக்கிலா(பொய், பொய், மெய், பொய்),
                  "but a custom asset with no right to payment for work done "
                  & "is not — the third criterion is two conditions, and this "
                  & "is where most construction contracts turn");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை காலப்போக்கிலா(பொய், பொய், பொய், மெய்),
                  "and a right to payment alone is not enough either");

ஓட்டம் = சமம்(ஓட்டம், கட்டுப்பாட்டு_குறியீடுகள்(மெய், மெய், பொய், பொய், பொய்), 2,
              "the indicators are counted, not weighed");
ஓட்டம் = சமம்(ஓட்டம், கட்டுப்பாட்டு_குறியீடுகள்(மெய், மெய், மெய், மெய், மெய்), 5,
              "all five pointing the same way is the easy case");

// =========================================================================
// முன்னேற்றம் — measuring it
// =========================================================================

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(செலவு_முன்னேற்றம்(4500, 9000)), 0.5,
              "cost-to-cost: half the expected cost is half the progress");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(செலவு_முன்னேற்றம்(4500, 0)),
                  "an obligation with no cost estimate has not been estimated");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(செலவு_முன்னேற்றம்(12000, 9000)), 1,
              "an overrun cannot take progress past complete");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(வெளியீட்டு_முன்னேற்றம்(30, 120)), 0.25,
              "the output method measures what the customer received");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(வெளியீட்டு_முன்னேற்றம்(30, 0)),
                  "with nothing to measure against, it refuses");

ஓட்டம் = சமம்(ஓட்டம், முன்னேற்றத்தை_வரம்பிடு(1.4), 1, "progress is held at 1");
ஓட்டம் = சமம்(ஓட்டம், முன்னேற்றத்தை_வரம்பிடு(0 - 0.2), 0, "and at 0");

// --- uninstalled materials, the adjustment that gets left out -------------

நேரடி_முன்னேற்றம் = மதிப்பு(செலவு_முன்னேற்றம்(4500, 9000));
ஓட்டம் = சமம்(ஓட்டம், இதுவரை_வருவாய்(12000, நேரடி_முன்னேற்றம்), 6000,
              "plain cost-to-cost would recognise 6,000");

சரிசெய்தது = மதிப்பு(நிறுவாத_பொருளுடன்_வருவாய்(12000, 4500, 9000, 3000));
ஓட்டம் = சமம்(ஓட்டம், சரிசெய்தது["முன்னேற்றம்"], 0.25,
              "excluding the machine, only a quarter of the work is done, "
              & "not half");
ஓட்டம் = சமம்(ஓட்டம், சரிசெய்தது["விளிம்புள்ள_வருவாய்"], 2250,
              "so 2,250 of revenue carries a margin");
ஓட்டம் = சமம்(ஓட்டம், சரிசெய்தது["விளிம்பற்ற_வருவாய்"], 3000,
              "and the machine comes back in at cost, with no margin at all");
ஓட்டம் = சமம்(ஓட்டம், சரிசெய்தது["மொத்த_வருவாய்"], 5250,
              "for 5,250 in total");
ஓட்டம் = சமம்(ஓட்டம், 6000 - சரிசெய்தது["மொத்த_வருவாய்"], 750,
              "750 less than the unadjusted figure — profit booked on a "
              & "machine the entity only took delivery of");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(நிறுவாத_பொருளுடன்_வருவாய்(12000, 3000, 3000,
                                                             3000)),
                  "a contract that is nothing but bought-in materials has "
                  & "no progress to measure");

ஓட்டம் = சமம்(ஓட்டம், மீட்பளவு_வருவாய்(4500, மெய்), 4500,
              "early on, revenue equals cost — zero margin");
ஓட்டம் = சமம்(ஓட்டம், மீட்பளவு_வருவாய்(4500, பொய்), 0,
              "and where recovery is not expected, nothing at all");

// =========================================================================
// கூட்டுப் பிடிப்பு — the cumulative catch-up
// =========================================================================

முதல்_காலம் = மதிப்பு(வருவாய்_நிலவரம்(12000, 4500, 9000, 0));
ஓட்டம் = சமம்(ஓட்டம், முதல்_காலம்["இந்தக்_காலம்"], 6000,
              "the first period recognises 6,000");
ஓட்டம் = சமம்(ஓட்டம், முதல்_காலம்["எதிர்பார்க்கும்_விளிம்பு"], 3000,
              "on an expected margin of 3,000");

// The estimate of total cost is revised from 9,000 to 20,000.
இரண்டாம்_காலம் = மதிப்பு(வருவாய்_நிலவரம்(12000, 5000, 20000, 6000));
ஓட்டம் = சமம்(ஓட்டம், இரண்டாம்_காலம்["இதுவரை_வருவாய்"], 3000,
              "the revised estimate drops revenue to date to 3,000");
ஓட்டம் = சமம்(ஓட்டம், இரண்டாம்_காலம்["இந்தக்_காலம்"], 0 - 3000,
              "so this period's revenue is negative 3,000 — a cumulative "
              & "catch-up, taken now rather than by restating last period");
ஓட்டம் = சமம்(ஓட்டம், இரண்டாம்_காலம்["எதிர்பார்க்கும்_விளிம்பு"], 0 - 8000,
              "and the contract is now expected to lose 8,000");
ஓட்டம் = சமம்(ஓட்டம், இந்தக்_காலத்து_வருவாய்(3000, 6000), 0 - 3000,
              "which is simply revenue to date less revenue already taken");

// =========================================================================
// இருப்புகள் — contract asset and contract liability
// =========================================================================

ஓட்டம் = சமம்(ஓட்டம், ஒப்பந்த_நிலை("A", 8000, 3000)["ஒப்பந்தச்_சொத்து"], 5000,
              "revenue ahead of billing is a contract asset");
ஓட்டம் = சமம்(ஓட்டம், ஒப்பந்த_நிலை("A", 8000, 3000)["ஒப்பந்தப்_பொறுப்பு"], 0,
              "and not a liability as well");
ஓட்டம் = சமம்(ஓட்டம், ஒப்பந்த_நிலை("B", 2000, 5000)["ஒப்பந்தப்_பொறுப்பு"], 3000,
              "billing ahead of revenue is a contract liability");
ஓட்டம் = சமம்(ஓட்டம், ஒப்பந்த_நிலை("C", 4000, 4000)["ஒப்பந்தச்_சொத்து"], 0,
              "a contract exactly in step has neither");

நிலைகள் = [ஒப்பந்த_நிலை("A", 8000, 3000),
            ஒப்பந்த_நிலை("B", 2000, 5000),
            ஒப்பந்த_நிலை("C", 6000, 4000)];
தொகுப்பு_விடை = ஒப்பந்தங்களைத்_தொகு(நிலைகள்);

ஓட்டம் = சமம்(ஓட்டம், தொகுப்பு_விடை["மொத்தச்_சொத்து"], 7000,
              "contract assets are added across contracts");
ஓட்டம் = சமம்(ஓட்டம், தொகுப்பு_விடை["மொத்தப்_பொறுப்பு"], 3000,
              "and contract liabilities separately — netting is per contract "
              & "only");
ஓட்டம் = சமம்(ஓட்டம், தொகுப்பு_விடை["நிகரம்"], 4000, "the net is available");
ஓட்டம் = வேறுபடு(ஓட்டம், தொகுப்பு_விடை["நிகரம்"], தொகுப்பு_விடை["மொத்தச்_சொத்து"],
                 "but it is not what goes on the balance sheet");

மறைப்பு = தவறாக_நிகரமிட்டால்(நிலைகள்);
ஓட்டம் = சமம்(ஓட்டம், மறைப்பு["மறைந்த_தொகை"], 3000,
              "netting the portfolio would hide 3,000 from each side of the "
              & "balance sheet at once");

ஓட்டம் = சமம்(ஓட்டம், உரிமை_வகை(மெய்), "பெறவேண்டியது",
              "only time left to run makes it a receivable");
ஓட்டம் = சமம்(ஓட்டம், உரிமை_வகை(பொய்), "ஒப்பந்தச்_சொத்து",
              "anything else outstanding makes it a contract asset");

ஓட்டம் = சமம்(ஓட்டம், தேக்கத்_தொகை(100000, 5), 5000,
              "five per cent retention on a certified bill");
ஓட்டம் = சமம்(ஓட்டம், விலைப்பட்டியல்_நிகரம்(100000, 5), 95000,
              "leaving 95,000 collectable now");
ஓட்டம் = சமம்(ஓட்டம், தேக்கத்தை_வகைப்படுத்து(5000, பொய்)["வகை"],
              "ஒப்பந்தச்_சொத்து",
              "retention held against defects is a contract asset");
ஓட்டம் = சமம்(ஓட்டம், தேக்கத்தை_வகைப்படுத்து(5000, மெய்)["வகை"],
              "பெறவேண்டியது",
              "and becomes a receivable once only the date stands in the way");

// =========================================================================
// ஒப்பந்தச் செலவு — capitalise or expense
// =========================================================================

ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  பெறுதல்_செலவின்_வகை(மெய், மெய், 24, 12)["முதலீடா"],
                  "a commission payable only on winning is capitalised");
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  இல்லை பெறுதல்_செலவின்_வகை(பொய், மெய், 24, 12)["முதலீடா"],
                  "bid costs incurred whether or not the tender succeeded are "
                  & "not incremental, however clearly they relate to it");
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  இல்லை பெறுதல்_செலவின்_வகை(மெய், மெய், 9, 12)["முதலீடா"],
                  "and the practical expedient expenses a short-lived one");
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  இல்லை பெறுதல்_செலவின்_வகை(மெய், பொய், 24, 12)["முதலீடா"],
                  "nothing unrecoverable is capitalised");

ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  நிறைவேற்றல்_செலவின்_வகை(மெய், மெய், மெய், பொய், பொய்)["முதலீடா"],
                  "mobilisation for work still to come is capitalised");
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  இல்லை நிறைவேற்றல்_செலவின்_வகை(மெய், மெய், மெய், பொய்,
                                                  மெய்)["முதலீடா"],
                  "but rework the entity caused is an expense — capitalising "
                  & "waste removes exactly the cost that is the problem");
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  இல்லை நிறைவேற்றல்_செலவின்_வகை(மெய், மெய், மெய், மெய்,
                                                  பொய்)["முதலீடா"],
                  "and so is a cost relating to performance already satisfied");
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  இல்லை நிறைவேற்றல்_செலவின்_வகை(பொய், மெய், மெய், பொய்,
                                                  பொய்)["முதலீடா"],
                  "general administration fails the first condition");

கழித்தது = கழிப்புத்_தொகை(2000, 0.25, 0);
ஓட்டம் = சமம்(ஓட்டம், கழித்தது["இதுவரை_கழித்தது"], 500,
              "a capitalised cost amortises on the same progress as the revenue");
ஓட்டம் = சமம்(ஓட்டம், கழித்தது["புத்தக_மதிப்பு"], 1500, "leaving 1,500 on the books");
ஓட்டம் = சமம்(ஓட்டம், கழிப்புத்_தொகை(2000, 0.5, 500)["இந்தக்_காலம்"], 500,
              "and the next period takes the increment, not the total");

ஓட்டம் = சமம்(ஓட்டம், முதலீட்டுக்_குறைவு(1500, 9000, 8000)["குறைவு"], 500,
              "a capitalised cost is impaired to what the remaining work can "
              & "still earn");
ஓட்டம் = சமம்(ஓட்டம், முதலீட்டுக்_குறைவு(1500, 9000, 6000)["குறைவு"], 0,
              "and not impaired when there is room");

// =========================================================================
// நட்டம் தரும் ஒப்பந்தம் — Ind AS 37, not 115
// =========================================================================
//
// Carrying on the re-estimated contract: 3,000 of revenue recognised of
// 12,000, so 9,000 remains; 5,000 of cost incurred of 20,000, so 15,000
// remains. Walking away would cost 20,000.

ஓட்டம் = சமம்(ஓட்டம், தவிர்க்க_முடியாத_செலவு(15000, 20000), 15000,
              "the unavoidable cost is the lower of fulfilling and exiting");
ஓட்டம் = சமம்(ஓட்டம், தவிர்க்க_முடியாத_செலவு(15000, 4000), 4000,
              "a small exit penalty caps the loss — nobody is worse off than "
              & "walking away");

ஓட்டம் = உறுதிசெய்(ஓட்டம், நட்டம்_தருமா(9000, 15000),
                  "15,000 of unavoidable cost against 9,000 of remaining "
                  & "revenue is onerous");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நட்டம்_தருமா(9000, 8000),
                  "and a contract that still earns more than it costs is not");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நட்டம்_தருமா(9000, 9000),
                  "breaking even exactly is not onerous either");

நட்டம் = நட்டக்_கணக்கு(9000, 15000, 2000);
ஓட்டம் = உறுதிசெய்(ஓட்டம், நட்டம்["நட்டமா"], "the contract is onerous");
ஓட்டம் = சமம்(ஓட்டம், நட்டம்["மொத்த_நட்டம்"], 6000,
              "the whole expected loss is 6,000, recognised now and not "
              & "spread over the rest of the contract");
ஓட்டம் = சமம்(ஓட்டம், நட்டம்["குறைவு"], 2000,
              "the dedicated asset is impaired first — all 2,000 of it");
ஓட்டம் = சமம்(ஓட்டம், நட்டம்["ஒதுக்கீடு"], 4000,
              "and only the remaining 4,000 becomes a provision");
ஓட்டம் = சமம்(ஓட்டம், நட்டம்["குறைவு"] + நட்டம்["ஒதுக்கீடு"],
              நட்டம்["மொத்த_நட்டம்"],
              "the two account for the whole loss and count it once — "
              & "providing the full 6,000 as well would count it twice");

ஓட்டம் = சமம்(ஓட்டம், நட்டக்_கணக்கு(9000, 15000, 0)["ஒதுக்கீடு"], 6000,
              "with no asset to absorb it, the whole loss is a provision");
ஓட்டம் = சமம்(ஓட்டம், நட்டக்_கணக்கு(9000, 15000, 9000)["ஒதுக்கீடு"], 0,
              "and an ample asset absorbs it entirely, leaving none");
ஓட்டம் = சமம்(ஓட்டம், நட்டக்_கணக்கு(9000, 8000, 2000)["மொத்த_நட்டம்"], 0,
              "a profitable contract needs neither");

சோதனை_முடிவு(ஓட்டம்);
