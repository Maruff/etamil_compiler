// __nUlakam/celavu/nilYyam.qmz — நிலையம் (cost centres, objects and elements)__
//
// __Financial accounting asks what was spent. Cost accounting asks where it went__
// __and what it attached to, and that needs two structures the ledger does not__
// __have: a place that incurs cost (a cost centre) and a thing that carries it__
// __(a cost object). Everything else in this directory hangs off them.__
//
// __Field and parameter names here are compound — நிலைய_வகை, கூறு_தொகை — because__
// __செலவு, தொகை, விலை, அளவு and நிலை are all keywords in this language. A bare__
// __keyword used as a field name is stored under its token name instead, so the__
// __record you read back is not the one you wrote. Compounding is the fix, and__
// __the same convention runs through kaNakkiyal/.__

// __--- What kind of place incurred it -------------------------------------__
//
// __The three-way split matters because only the first absorbs cost into__
// __product: service and administrative centres have their cost re-apportioned__
// __onto production centres before absorption, never onto units directly.__
செயல் வகை_உற்பத்தி()  { திரும்பு "உற்பத்தி"; }
செயல் வகை_சேவைத்துறை() { திரும்பு "சேவை"; }
செயல் வகை_நிர்வாகம்()  { திரும்பு "நிர்வாகம்"; }

செயல் நிலைய_வகை_செல்லுபடியா(நிலைய_வகை) {
    (நிலைய_வகை == "உற்பத்தி") எனில் { திரும்பு மெய்; }
    (நிலைய_வகை == "சேவை")     எனில் { திரும்பு மெய்; }
    (நிலைய_வகை == "நிர்வாகம்") எனில் { திரும்பு மெய்; }
    திரும்பு பொய்;
}

// __உற்பத்தி_நிலையமா(நிலையம்) — does cost absorb into units here?__
செயல் உற்பத்தி_நிலையமா(நிலையம்) {
    திரும்பு நிலையம்.நிலைய_வகை == "உற்பத்தி";
}

// நிலையம்_ஆக்கு(நிலைய_குறி, நிலைய_பெயர், நிலைய_வகை)
செயல் நிலையம்_ஆக்கு(நிலைய_குறி, நிலைய_பெயர், நிலைய_வகை) {
    (இல்லை நிலைய_வகை_செல்லுபடியா(நிலைய_வகை)) எனில் {
        திரும்பு தவறு("அறியப்படாத நிலைய வகை: " & நிலைய_வகை);
    }
    திரும்பு சரி({
        நிலைய_குறி: நிலைய_குறி,
        நிலைய_பெயர்: நிலைய_பெயர்,
        நிலைய_வகை: நிலைய_வகை
    });
}

செயல் நிலையம்_தேடு(நிலையங்கள், நிலைய_குறி) {
    ஒவ்வொரு ஒரு_நிலையம் இல் நிலையங்கள் {
        (ஒரு_நிலையம்.நிலைய_குறி == நிலைய_குறி) எனில் {
            திரும்பு சரி(ஒரு_நிலையம்);
        }
    }
    திரும்பு தவறு("நிலையம் காணவில்லை: " & நிலைய_குறி);
}

செயல் வகையால்_நிலையங்கள்(நிலையங்கள், நிலைய_வகை) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_நிலையம் இல் நிலையங்கள் {
        (ஒரு_நிலையம்.நிலைய_வகை == நிலைய_வகை) எனில் {
            விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_நிலையம்);
        }
    }
    திரும்பு விடை_பட்டி;
}

// __--- What carries it ----------------------------------------------------__

// செலவுப்_பொருள்_ஆக்கு(பொருள்_குறி, பொருள்_பெயர், அலகுகள்)
//
// __The cost object: a job, a batch, a process, a contract, a product line. The__
// __unit count is held with it because per-unit cost is meaningless without it,__
// __and a cost sheet that reports a unit cost against the wrong quantity is the__
// __most common error in the whole discipline.__
செயல் செலவுப்_பொருள்_ஆக்கு(பொருள்_குறி, பொருள்_பெயர், அலகுகள்) {
    (அலகுகள் < 0) எனில் {
        திரும்பு தவறு("அலகுகள் எதிர்மறையாக இருக்க முடியாது");
    }
    திரும்பு சரி({
        பொருள்_குறி: பொருள்_குறி,
        பொருள்_பெயர்: பொருள்_பெயர்,
        அலகுகள்: அலகுகள்
    });
}

// __--- The elements of cost -----------------------------------------------__

// கூறு_ஆக்கு(கூறு_பெயர், கூறு_தொகை, நேரடியா, மாறுபடுமா)
//
// __Two independent classifications, and keeping them independent is the point.__
// __Direct/indirect answers "can this be traced to the object?" and decides__
// __whether it is absorbed or apportioned. Variable/fixed answers "does it move__
// __with volume?" and decides whether it enters a contribution calculation.__
// __Direct cost is usually variable and indirect usually fixed, but the pairs__
// __are not the same question and a semi-variable element belongs to neither__
// __cleanly — which is why மாறுபடுமா is a fraction, not a flag.__
செயல் கூறு_ஆக்கு(கூறு_பெயர், கூறு_தொகை, நேரடியா, மாறுபடுமா) {
    திரும்பு {
        கூறு_பெயர்: கூறு_பெயர்,
        கூறு_தொகை: கூறு_தொகை,
        நேரடியா: நேரடியா,
        மாறுபடுமா: மாறுபடுமா
    };
}

செயல் கூறுகளின்_கூட்டல்(கூறுகள்) {
    மொத்தக்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_கூறு இல் கூறுகள் {
        மொத்தக்_கூட்டல் = மொத்தக்_கூட்டல் + ஒரு_கூறு.கூறு_தொகை;
    }
    திரும்பு மொத்தக்_கூட்டல்;
}

செயல் நேரடிக்_கூறுகள்(கூறுகள்) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_கூறு இல் கூறுகள் {
        (ஒரு_கூறு.நேரடியா) எனில் { விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_கூறு); }
    }
    திரும்பு விடை_பட்டி;
}

செயல் மறைமுகக்_கூறுகள்(கூறுகள்) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_கூறு இல் கூறுகள் {
        (இல்லை ஒரு_கூறு.நேரடியா) எனில் { விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_கூறு); }
    }
    திரும்பு விடை_பட்டி;
}

// __மாறும்_பகுதி(கூறுகள்) — the volume-sensitive rupees inside a mixed list__
//
// __A semi-variable element with மாறுபடுமா 0.6 contributes 60% of itself here__
// __and 40% to நிலையான_பகுதி. Splitting a mixed list this way is what makes a__
// __contribution figure computable from an absorption cost sheet.__
செயல் மாறும்_பகுதி(கூறுகள்) {
    மாறும்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_கூறு இல் கூறுகள் {
        மாறும்_கூட்டல் = மாறும்_கூட்டல் + ஒரு_கூறு.கூறு_தொகை * ஒரு_கூறு.மாறுபடுமா;
    }
    திரும்பு மாறும்_கூட்டல்;
}

செயல் நிலையான_பகுதி(கூறுகள்) {
    திரும்பு கூறுகளின்_கூட்டல்(கூறுகள்) - மாறும்_பகுதி(கூறுகள்);
}
