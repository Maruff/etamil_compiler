// nUlakam/qittam/kattuppAtu.qmz — கட்டுப்பாட்டுக் கணக்கு (control accounts,
// the time-phased budget, and reserves)
//
// The control account is where project structure meets the ledger: a WBS node
// designated as the level at which scope, budget, actual cost and schedule are
// integrated and performance is measured. It has one owner, one code, and that
// code is a real account in the accounting system, so an invoice can be booked
// straight to it instead of to one undifferentiated "project" account.
//
// If that mapping is not designed before the first invoice arrives it gets
// improvised later, and the improvisation is always the same: a spreadsheet in
// which someone reconciles project codes to cost centres every month. That
// spreadsheet is where project cost control quietly dies.
//
// A budget is not a total. It is a total *distributed across periods*, because
// a project with the right total and the wrong phasing reports an alarming
// variance every month while being perfectly on track. Planned value — the PV
// of earned value analysis — is read off that distribution and nowhere else.

இறக்கு "pakuppu.qmz";

// --- The control account -------------------------------------------------

// கணக்கு_ஆக்கு(கணக்குக்_குறி, கணு_குறி, உரிமையாளர்)
//
// கணக்குக்_குறி is the code the ledger knows. கணு_குறி is the WBS node it sits
// on. Keeping them as separate fields rather than one identifier is what lets
// the accounting structure and the work structure be renamed independently,
// which they will be.
செயல் கணக்கு_ஆக்கு(கணக்குக்_குறி, கணு_குறி, உரிமையாளர்) {
    திரும்பு {
        கணக்குக்_குறி: கணக்குக்_குறி,
        கணு_குறி: கணு_குறி,
        உரிமையாளர்: உரிமையாளர்
    };
}

// ஒரே_கணக்கா(கணக்குகள், கணுக்கள், கணு_குறி)
//
// Exactly one control account must lie on the path from a work package to the
// root. Two means the package's cost is counted twice; none means it is
// counted nowhere. Neither shows up in a tree view, and both show up in the
// totals, which is the worst possible combination.
செயல் ஒரே_கணக்கா(கணக்குகள், கணுக்கள், கணு_குறி) {
    திரும்பு பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள், கணு_குறி) == 1;
}

செயல் பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள், கணு_குறி) {
    (கணு_குறி == "") எனில் { திரும்பு 0; }
    எண்ணிக்கை = 0;
    ஒவ்வொரு ஒரு_கணக்கு இல் கணக்குகள் {
        (ஒரு_கணக்கு.கணு_குறி == கணு_குறி) எனில் { எண்ணிக்கை = எண்ணிக்கை + 1; }
    }
    விடை = கணு_தேடு(கணுக்கள், கணு_குறி);
    (தவறா(விடை)) எனில் { திரும்பு எண்ணிக்கை; }
    திரும்பு எண்ணிக்கை
           + பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள்,
                                 மதிப்பு(விடை).பெற்றோர்_குறி);
}

// கட்டமைப்பை_சரிபார்(கணக்குகள், கணுக்கள்) — every work package, checked
செயல் கட்டமைப்பை_சரிபார்(கணக்குகள், கணுக்கள்) {
    ஒவ்வொரு ஒரு_கணு இல் வேலைத்_தொகுப்புகள்(கணுக்கள்) {
        எத்தனை = பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள், ஒரு_கணு.கணு_குறி);
        (எத்தனை != 1) எனில் {
            திரும்பு தவறு(ஒரு_கணு.கணு_குறி & ": பாதையில் "
                          & எத்தனை & " கட்டுப்பாட்டுக் கணக்குகள், ஒன்று வேண்டும்");
        }
    }
    திரும்பு சரி(மெய்);
}

// --- The time-phased budget ---------------------------------------------

செயல் காலப்_பகிர்வு(காலம்_எண், காலத்_தொகை) {
    திரும்பு { காலம்_எண்: காலம்_எண், காலத்_தொகை: காலத்_தொகை };
}

// திரட்டிய_நிதி(பகிர்வுகள், காலம்_வரை) — the S-curve read at one period
//
// This is planned value. It is cumulative by definition: PV at period 10 is
// everything scheduled to be complete by then, not period 10's slice.
செயல் திரட்டிய_நிதி(பகிர்வுகள், காலம்_வரை) {
    ஓடும்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_பகிர்வு இல் பகிர்வுகள் {
        (ஒரு_பகிர்வு.காலம்_எண் <= காலம்_வரை) எனில் {
            ஓடும்_கூட்டல் = ஓடும்_கூட்டல் + ஒரு_பகிர்வு.காலத்_தொகை;
        }
    }
    திரும்பு ஓடும்_கூட்டல்;
}

செயல் மொத்த_நிதி(பகிர்வுகள்) {
    ஓடும்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_பகிர்வு இல் பகிர்வுகள் {
        ஓடும்_கூட்டல் = ஓடும்_கூட்டல் + ஒரு_பகிர்வு.காலத்_தொகை;
    }
    திரும்பு ஓடும்_கூட்டல்;
}

// --- Reserves ------------------------------------------------------------

// நிதித்_தொகுதி_ஆக்கு(அடிப்படை_நிதி, தற்செயல்_இருப்பு, மேலாண்மை_இருப்பு)
//
// Two reserves, and the distinction is not bureaucratic. Contingency reserve
// covers *identified* risks, sits inside the performance measurement baseline
// and is the project manager's to spend. Management reserve covers the
// unknown, sits outside the baseline and belongs to the sponsor.
//
// Performance is measured against the baseline. If management reserve were
// inside it, drawing on the reserve would improve reported performance, which
// is exactly backwards — and is how a project 30% over budget reports itself
// as on plan.
செயல் நிதித்_தொகுதி_ஆக்கு(அடிப்படை_நிதி, தற்செயல்_இருப்பு, மேலாண்மை_இருப்பு) {
    திரும்பு {
        அடிப்படை_நிதி: அடிப்படை_நிதி,
        தற்செயல்_இருப்பு: தற்செயல்_இருப்பு,
        மேலாண்மை_இருப்பு: மேலாண்மை_இருப்பு
    };
}

// அளவீட்டு_அடிப்படை(தொகுதி) — the performance measurement baseline
செயல் அளவீட்டு_அடிப்படை(தொகுதி) {
    திரும்பு தொகுதி.அடிப்படை_நிதி + தொகுதி.தற்செயல்_இருப்பு;
}

// அனுமதித்த_நிதி(தொகுதி) — baseline plus management reserve
செயல் அனுமதித்த_நிதி(தொகுதி) {
    திரும்பு அளவீட்டு_அடிப்படை(தொகுதி) + தொகுதி.மேலாண்மை_இருப்பு;
}

// இருப்பை_விடுவி(தொகுதி, விடுவிக்கும்_தொகை)
//
// Releasing management reserve moves value into the baseline; it does not
// create any. The total authorised funding is unchanged by the transfer, which
// is the property the test asserts. A release larger than the reserve is a
// தவறு rather than a silent overdraft.
செயல் இருப்பை_விடுவி(தொகுதி, விடுவிக்கும்_தொகை) {
    (விடுவிக்கும்_தொகை <= 0) எனில் {
        திரும்பு தவறு("விடுவிப்புத் தொகை பூஜ்யம் அல்லது எதிர்மறை");
    }
    (விடுவிக்கும்_தொகை > தொகுதி.மேலாண்மை_இருப்பு) எனில் {
        திரும்பு தவறு("மேலாண்மை இருப்பு " & தொகுதி.மேலாண்மை_இருப்பு
                      & " மட்டுமே; " & விடுவிக்கும்_தொகை & " கேட்கப்பட்டது");
    }
    திரும்பு சரி({
        அடிப்படை_நிதி: தொகுதி.அடிப்படை_நிதி + விடுவிக்கும்_தொகை,
        தற்செயல்_இருப்பு: தொகுதி.தற்செயல்_இருப்பு,
        மேலாண்மை_இருப்பு: தொகுதி.மேலாண்மை_இருப்பு - விடுவிக்கும்_தொகை
    });
}
