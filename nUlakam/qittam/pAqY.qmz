// nUlakam/qittam/pAqY.qmz — கடுமையான பாதை (the critical path method)
//
// The WBS says what must be produced. The network says in what order, and from
// that one fact everything schedulers care about falls out: the earliest each
// activity can happen, the latest it can happen without delaying the project,
// how much slack that leaves, and which chain has none.
//
// Two passes over a directed acyclic graph:
//
//   forward   ES = max(EF of predecessors)        EF = ES + duration
//   backward  LF = min(LS of successors)          LS = LF − duration
//   float     LS − ES, equivalently LF − EF
//
// The critical path is the zero-float chain, and it is also necessarily the
// longest path through the network. Its length is the project duration.
//
// **Implementation note.** The passes are iterated to a fixed point rather
// than run over a topological sort. The textbook algorithm needs the sort;
// this does not, and for the sizes a human builds by hand the cost is
// irrelevant. The benefit is that a cycle cannot produce a stack overflow or a
// wrong answer — it produces a தவறு from சுழற்சி_உள்ளதா, which is checked
// first. A cycle is the commonest structural error in a hand-built network and
// it must fail loudly.
//
// Lags and the four dependency types are not modelled. Finish-to-start only,
// which is what CPM proper is; start-to-start with a lag belongs to a richer
// scheduler and would change every signature here.

// செயல்_ஆக்கு(செயல்_குறி, செயல்_காலம், முன்னோடிகள்)
//
// முன்னோடிகள் is a list of activity codes. An empty list starts the network.
செயல் செயல்_ஆக்கு(செயல்_குறி, செயல்_காலம், முன்னோடிகள்) {
    திரும்பு {
        செயல்_குறி: செயல்_குறி,
        செயல்_காலம்: செயல்_காலம்,
        முன்னோடிகள்: முன்னோடிகள்
    };
}

செயல் செயலைத்_தேடு(செயல்கள், செயல்_குறி) {
    ஒவ்வொரு ஒரு_செயல் இல் செயல்கள் {
        (ஒரு_செயல்.செயல்_குறி == செயல்_குறி) எனில் { திரும்பு சரி(ஒரு_செயல்); }
    }
    திரும்பு தவறு("செயல் காணவில்லை: " & செயல்_குறி);
}

// வழித்தோன்றல்கள்(செயல்கள், செயல்_குறி) — the successors of an activity
செயல் வழித்தோன்றல்கள்(செயல்கள், செயல்_குறி) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_செயல் இல் செயல்கள் {
        ஒவ்வொரு ஒரு_முன்னோடி இல் ஒரு_செயல்.முன்னோடிகள் {
            (ஒரு_முன்னோடி == செயல்_குறி) எனில் {
                விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_செயல்);
            }
        }
    }
    திரும்பு விடை_பட்டி;
}

// --- Structural checks --------------------------------------------------

// முன்னோடிகள்_உள்ளனவா(செயல்கள்) — every named predecessor must exist
செயல் முன்னோடிகள்_உள்ளனவா(செயல்கள்) {
    ஒவ்வொரு ஒரு_செயல் இல் செயல்கள் {
        ஒவ்வொரு ஒரு_முன்னோடி இல் ஒரு_செயல்.முன்னோடிகள் {
            (தவறா(செயலைத்_தேடு(செயல்கள், ஒரு_முன்னோடி))) எனில் {
                திரும்பு தவறு(ஒரு_செயல்.செயல்_குறி & " குறிக்கும் முன்னோடி "
                              & ஒரு_முன்னோடி & " இல்லை");
            }
        }
    }
    திரும்பு சரி(மெய்);
}

// சுழற்சி_உள்ளதா(செயல்கள்) — is there a cycle?
//
// Repeatedly strip activities all of whose predecessors have already been
// stripped. What cannot be stripped is in, or downstream of, a cycle. This is
// Kahn's algorithm used only for its emptiness test.
செயல் சுழற்சி_உள்ளதா(செயல்கள்) {
    தீர்ந்தவை = [];
    மாற்றம்_உண்டு = மெய்;
    (மாற்றம்_உண்டு) சுற்று {
        மாற்றம்_உண்டு = பொய்;
        ஒவ்வொரு ஒரு_செயல் இல் செயல்கள் {
            (இல்லை குறி_உள்ளதா(தீர்ந்தவை, ஒரு_செயல்.செயல்_குறி)) எனில் {
                அனைத்தும்_தீர்ந்தன = மெய்;
                ஒவ்வொரு ஒரு_முன்னோடி இல் ஒரு_செயல்.முன்னோடிகள் {
                    (இல்லை குறி_உள்ளதா(தீர்ந்தவை, ஒரு_முன்னோடி)) எனில் {
                        அனைத்தும்_தீர்ந்தன = பொய்;
                    }
                }
                (அனைத்தும்_தீர்ந்தன) எனில் {
                    தீர்ந்தவை = இணை(தீர்ந்தவை, ஒரு_செயல்.செயல்_குறி);
                    மாற்றம்_உண்டு = மெய்;
                }
            }
        }
    }
    திரும்பு நீளம்(தீர்ந்தவை) != நீளம்(செயல்கள்);
}

// --- The two passes ------------------------------------------------------

// வலையைக்_கணக்கிடு(செயல்கள்)
//
// One call does both passes and returns the activities enriched with
// முந்தைய_தொடக்கம் (ES), முந்தைய_முடிவு (EF), பிந்தைய_தொடக்கம் (LS),
// பிந்தைய_முடிவு (LF) and மிதப்பு (float).
செயல் வலையைக்_கணக்கிடு(செயல்கள்) {
    சரிபார்ப்பு = முன்னோடிகள்_உள்ளனவா(செயல்கள்);
    (தவறா(சரிபார்ப்பு)) எனில் { திரும்பு சரிபார்ப்பு; }
    (சுழற்சி_உள்ளதா(செயல்கள்)) எனில் {
        திரும்பு தவறு("வலையில் சுழற்சி உள்ளது: முன்னோக்கு கணக்கிட முடியாது");
    }

    // Forward pass, iterated to a fixed point.
    முந்தைய = [];
    ஒவ்வொரு ஒரு_செயல் இல் செயல்கள் {
        முந்தைய = இணை(முந்தைய, { செயல்_குறி: ஒரு_செயல்.செயல்_குறி,
                                  தொடக்கம்: 0,
                                  முடிவு: ஒரு_செயல்.செயல்_காலம் });
    }
    மாற்றம்_உண்டு = மெய்;
    (மாற்றம்_உண்டு) சுற்று {
        மாற்றம்_உண்டு = பொய்;
        ஒவ்வொரு ஒரு_செயல் இல் செயல்கள் {
            புதிய_தொடக்கம் = 0;
            ஒவ்வொரு ஒரு_முன்னோடி இல் ஒரு_செயல்.முன்னோடிகள் {
                முடிவு_மதிப்பு = பதிவைத்_தேடு(முந்தைய, ஒரு_முன்னோடி, "முடிவு");
                (முடிவு_மதிப்பு > புதிய_தொடக்கம்) எனில் {
                    புதிய_தொடக்கம் = முடிவு_மதிப்பு;
                }
            }
            பழைய_தொடக்கம் = பதிவைத்_தேடு(முந்தைய, ஒரு_செயல்.செயல்_குறி,
                                           "தொடக்கம்");
            (புதிய_தொடக்கம் != பழைய_தொடக்கம்) எனில் {
                முந்தைய = பதிவை_மாற்று(முந்தைய, ஒரு_செயல்.செயல்_குறி,
                                        புதிய_தொடக்கம்,
                                        புதிய_தொடக்கம் + ஒரு_செயல்.செயல்_காலம்);
                மாற்றம்_உண்டு = மெய்;
            }
        }
    }

    திட்ட_காலம் = 0;
    ஒவ்வொரு ஒரு_பதிவு இல் முந்தைய {
        (ஒரு_பதிவு.முடிவு > திட்ட_காலம்) எனில் { திட்ட_காலம் = ஒரு_பதிவு.முடிவு; }
    }

    // Backward pass, likewise. Every activity starts at the project duration
    // and is pulled earlier by its successors.
    பிந்தைய = [];
    ஒவ்வொரு ஒரு_செயல் இல் செயல்கள் {
        பிந்தைய = இணை(பிந்தைய, { செயல்_குறி: ஒரு_செயல்.செயல்_குறி,
                                  தொடக்கம்: திட்ட_காலம் - ஒரு_செயல்.செயல்_காலம்,
                                  முடிவு: திட்ட_காலம் });
    }
    மாற்றம்_உண்டு = மெய்;
    (மாற்றம்_உண்டு) சுற்று {
        மாற்றம்_உண்டு = பொய்;
        ஒவ்வொரு ஒரு_செயல் இல் செயல்கள் {
            புதிய_முடிவு = திட்ட_காலம்;
            ஒவ்வொரு ஒரு_பின் இல் வழித்தோன்றல்கள்(செயல்கள்,
                                                  ஒரு_செயல்.செயல்_குறி) {
                தொடக்க_மதிப்பு = பதிவைத்_தேடு(பிந்தைய, ஒரு_பின்.செயல்_குறி,
                                                "தொடக்கம்");
                (தொடக்க_மதிப்பு < புதிய_முடிவு) எனில் {
                    புதிய_முடிவு = தொடக்க_மதிப்பு;
                }
            }
            பழைய_முடிவு = பதிவைத்_தேடு(பிந்தைய, ஒரு_செயல்.செயல்_குறி, "முடிவு");
            (புதிய_முடிவு != பழைய_முடிவு) எனில் {
                பிந்தைய = பதிவை_மாற்று(பிந்தைய, ஒரு_செயல்.செயல்_குறி,
                                        புதிய_முடிவு - ஒரு_செயல்.செயல்_காலம்,
                                        புதிய_முடிவு);
                மாற்றம்_உண்டு = மெய்;
            }
        }
    }

    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_செயல் இல் செயல்கள் {
        முன்_தொ = பதிவைத்_தேடு(முந்தைய, ஒரு_செயல்.செயல்_குறி, "தொடக்கம்");
        முன்_மு = பதிவைத்_தேடு(முந்தைய, ஒரு_செயல்.செயல்_குறி, "முடிவு");
        பின்_தொ = பதிவைத்_தேடு(பிந்தைய, ஒரு_செயல்.செயல்_குறி, "தொடக்கம்");
        பின்_மு = பதிவைத்_தேடு(பிந்தைய, ஒரு_செயல்.செயல்_குறி, "முடிவு");
        விடை_பட்டி = இணை(விடை_பட்டி, {
            செயல்_குறி: ஒரு_செயல்.செயல்_குறி,
            செயல்_காலம்: ஒரு_செயல்.செயல்_காலம்,
            முந்தைய_தொடக்கம்: முன்_தொ,
            முந்தைய_முடிவு: முன்_மு,
            பிந்தைய_தொடக்கம்: பின்_தொ,
            பிந்தைய_முடிவு: பின்_மு,
            மிதப்பு: பின்_தொ - முன்_தொ
        });
    }
    திரும்பு சரி({ செயல்கள்: விடை_பட்டி, திட்ட_காலம்: திட்ட_காலம் });
}

// --- Reading the answer --------------------------------------------------

// கடுமையானவை(கணக்கிட்டவை) — the zero-float activities
//
// Float belongs to the project, not to the activity's owner. Where it is
// treated as a private buffer it is consumed first and unavailable when
// genuinely needed, which is a governance point rather than a technical one.
செயல் கடுமையானவை(கணக்கிட்டவை) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_செயல் இல் கணக்கிட்டவை.செயல்கள் {
        (ஒரு_செயல்.மிதப்பு == 0) எனில் {
            விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_செயல்);
        }
    }
    திரும்பு விடை_பட்டி;
}

// உணர்திறன்_வலையா(கணக்கிட்டவை) — is the network sensitive?
//
// A network where most activities are critical absorbs no disturbance: a small
// slip anywhere makes a new path critical. One with a single critical chain
// and generous float elsewhere is insensitive. Half is the conventional line
// and it is a judgement, not a law.
செயல் உணர்திறன்_வலையா(கணக்கிட்டவை) {
    மொத்தம் = நீளம்(கணக்கிட்டவை.செயல்கள்);
    (மொத்தம் == 0) எனில் { திரும்பு பொய்; }
    திரும்பு நீளம்(கடுமையானவை(கணக்கிட்டவை)) * 2 >= மொத்தம்;
}

// பெறு_புலம்(கணக்கிட்ட_செயல்கள், செயல்_குறி, புலப்_பெயர்)
//
// One computed field of one activity, by name. Exists because the result of
// வலையைக்_கணக்கிடு is a list and the caller almost always wants a single
// figure out of it — "what is D's float?" — rather than the whole table.
// Valid field names are முந்தைய_தொடக்கம், முந்தைய_முடிவு,
// பிந்தைய_தொடக்கம், பிந்தைய_முடிவு, மிதப்பு and செயல்_காலம்.
செயல் பெறு_புலம்(கணக்கிட்ட_செயல்கள், செயல்_குறி, புலப்_பெயர்) {
    ஒவ்வொரு ஒரு_செயல் இல் கணக்கிட்ட_செயல்கள் {
        (ஒரு_செயல்.செயல்_குறி == செயல்_குறி) எனில் {
            (புலப்_பெயர் == "முந்தைய_தொடக்கம்") எனில் {
                திரும்பு ஒரு_செயல்.முந்தைய_தொடக்கம்;
            }
            (புலப்_பெயர் == "முந்தைய_முடிவு") எனில் {
                திரும்பு ஒரு_செயல்.முந்தைய_முடிவு;
            }
            (புலப்_பெயர் == "பிந்தைய_தொடக்கம்") எனில் {
                திரும்பு ஒரு_செயல்.பிந்தைய_தொடக்கம்;
            }
            (புலப்_பெயர் == "பிந்தைய_முடிவு") எனில் {
                திரும்பு ஒரு_செயல்.பிந்தைய_முடிவு;
            }
            (புலப்_பெயர் == "செயல்_காலம்") எனில் {
                திரும்பு ஒரு_செயல்.செயல்_காலம்;
            }
            திரும்பு ஒரு_செயல்.மிதப்பு;
        }
    }
    திரும்பு 0;
}

// --- Small helpers the passes need --------------------------------------

செயல் குறி_உள்ளதா(பட்டியல், தேடும்_குறி) {
    ஒவ்வொரு ஒன்று இல் பட்டியல் {
        (ஒன்று == தேடும்_குறி) எனில் { திரும்பு மெய்; }
    }
    திரும்பு பொய்;
}

செயல் பதிவைத்_தேடு(பதிவுகள், செயல்_குறி, புலப்_பெயர்) {
    ஒவ்வொரு ஒரு_பதிவு இல் பதிவுகள் {
        (ஒரு_பதிவு.செயல்_குறி == செயல்_குறி) எனில் {
            (புலப்_பெயர் == "தொடக்கம்") எனில் { திரும்பு ஒரு_பதிவு.தொடக்கம்; }
            திரும்பு ஒரு_பதிவு.முடிவு;
        }
    }
    திரும்பு 0;
}

செயல் பதிவை_மாற்று(பதிவுகள், செயல்_குறி, புது_தொடக்கம், புது_முடிவு) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_பதிவு இல் பதிவுகள் {
        (ஒரு_பதிவு.செயல்_குறி == செயல்_குறி) எனில் {
            விடை_பட்டி = இணை(விடை_பட்டி, { செயல்_குறி: செயல்_குறி,
                                            தொடக்கம்: புது_தொடக்கம்,
                                            முடிவு: புது_முடிவு });
        } இன்றேல் {
            விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_பதிவு);
        }
    }
    திரும்பு விடை_பட்டி;
}
