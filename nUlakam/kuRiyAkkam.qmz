// nUlakam/kuRiyAkkam.qmz — குறியாக்கம் (encoding): base64 and hex
//
// Written in eTamil. The host provides only பைட்டுகள் and பைட்டுச்_சரம் — the
// UTF-8 bytes of a string and the string back — because a byte is not
// something the language can reach on its own. Everything above that is
// arithmetic and string indexing, which it can, so this is ordinary eTamil
// rather than more Rust.
//
// A byte array is an array of numbers. There is no separate byte type, and
// adding one would have touched every exhaustive match in the value path to
// express something already representable.
//
//   அறுபத்துநான்கு_ஆக்கு(சரம்)  -> base64 text
//   அறுபத்துநான்கு_படி(சரம்)    -> சரி(சரம்) or தவறு
//   பதினாறு_ஆக்கு(சரம்)         -> lowercase hex
//   பதினாறு_படி(சரம்)           -> சரி(சரம்) or தவறு

இறக்கு "kaNiqam.qmz";
இறக்கு "col.qmz";

செயல் அறுபத்துநான்கு_எழுத்துகள்() {
    திரும்பு "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
}

செயல் பதினாறு_எழுத்துகள்() { திரும்பு "0123456789abcdef"; }

// --- base64 ---------------------------------------------------------------

// அறுபத்துநான்கு_ஆக்கு(சரம்) — text as base64
//
// Three bytes carry 24 bits, which divide into four 6-bit groups. Without a
// shift operator the groups come out by division and remainder, which is the
// same arithmetic written differently.
செயல் அறுபத்துநான்கு_ஆக்கு(மூலம்) {
    எழுத்துகள் = அறுபத்துநான்கு_எழுத்துகள்();
    பைட்டு_அணி = பைட்டுகள்(சொல்லாக்கு(மூலம்));
    மொத்தம் = நீளம்(பைட்டு_அணி);

    விடை = "";
    இடம்_எண் = 0;

    (இடம்_எண் < மொத்தம்) சுற்று {
        // The last group may be short, so the missing bytes count as zero and
        // the output is padded with '=' to say how many were absent.
        முதல் = பைட்டு_அணி[இடம்_எண்];
        உள்ளது = மொத்தம் - இடம்_எண்;

        இரண்டாம் = 0;
        (உள்ளது > 1) எனில் { இரண்டாம் = பைட்டு_அணி[இடம்_எண் + 1]; }
        மூன்றாம் = 0;
        (உள்ளது > 2) எனில் { மூன்றாம் = பைட்டு_அணி[இடம்_எண் + 2]; }

        கூட்டுத்_தொகை = முதல் * 65536 + இரண்டாம் * 256 + மூன்றாம்;

        அ = தரை(கூட்டுத்_தொகை / 262144);
        ஆ = மீதி(தரை(கூட்டுத்_தொகை / 4096), 64);
        இ = மீதி(தரை(கூட்டுத்_தொகை / 64), 64);
        ஈ = மீதி(கூட்டுத்_தொகை, 64);

        விடை = விடை & எழுத்துகள்[அ] & எழுத்துகள்[ஆ];
        (உள்ளது > 2) எனில் {
            விடை = விடை & எழுத்துகள்[இ] & எழுத்துகள்[ஈ];
        }
        இன்றேல் {
            (உள்ளது == 2) எனில் { விடை = விடை & எழுத்துகள்[இ] & "="; }
            இன்றேல் { விடை = விடை & "=="; }
        }

        இடம்_எண் = இடம்_எண் + 3;
    }

    திரும்பு விடை;
}

// அறுபத்துநான்கு_படி(சரம்) — base64 back to text
செயல் அறுபத்துநான்கு_படி(குறியிட்டது) {
    எழுத்துகள் = அறுபத்துநான்கு_எழுத்துகள்();
    உரைப்பு = சொல்லாக்கு(குறியிட்டது);
    மொத்தம் = நீளம்(உரைப்பு);

    // Six bits at a time into an accumulator; every time eight are available
    // a byte comes out. Padding contributes no bits, which is what makes a
    // short final group work.
    சேமிப்பு = 0;
    பிட்டுகள் = 0;
    பைட்டு_அணி = [];

    எண்ணி = 0;
    (எண்ணி < மொத்தம்) சுற்று {
        ஒரு_எழுத்து = உரைப்பு[எண்ணி];

        (ஒரு_எழுத்து != "=" மற்றும் ஒரு_எழுத்து != "\n" மற்றும் ஒரு_எழுத்து != "\r") எனில் {
            மதிப்பு_எண் = தேடு(எழுத்துகள், ஒரு_எழுத்து);
            (மதிப்பு_எண் < 0) எனில் {
                திரும்பு தவறு("அறுபத்துநான்கில் இல்லாத எழுத்து: " & ஒரு_எழுத்து);
            }

            சேமிப்பு = சேமிப்பு * 64 + மதிப்பு_எண்;
            பிட்டுகள் = பிட்டுகள் + 6;

            (பிட்டுகள் >= 8) எனில் {
                பிட்டுகள் = பிட்டுகள் - 8;
                வகுப்பான் = 1;
                எண்ணிக்கை = 0;
                (எண்ணிக்கை < பிட்டுகள்) சுற்று {
                    வகுப்பான் = வகுப்பான் * 2;
                    எண்ணிக்கை = எண்ணிக்கை + 1;
                }
                ஒரு_பைட்டு = தரை(சேமிப்பு / வகுப்பான்);
                சேமிப்பு = மீதி(சேமிப்பு, வகுப்பான்);
                பைட்டு_அணி = இணை(பைட்டு_அணி, ஒரு_பைட்டு);
            }
        }

        எண்ணி = எண்ணி + 1;
    }

    திரும்பு பைட்டுச்_சரம்(பைட்டு_அணி);
}

// --- hex ------------------------------------------------------------------

செயல் பதினாறு_ஆக்கு(மூலம்) {
    எழுத்துகள் = பதினாறு_எழுத்துகள்();
    விடை = "";
    ஒவ்வொரு ஒரு_பைட்டு இல் பைட்டுகள்(சொல்லாக்கு(மூலம்)) {
        விடை = விடை & எழுத்துகள்[தரை(ஒரு_பைட்டு / 16)] & எழுத்துகள்[மீதி(ஒரு_பைட்டு, 16)];
    }
    திரும்பு விடை;
}

செயல் பதினாறு_படி(குறியிட்டது) {
    எழுத்துகள் = பதினாறு_எழுத்துகள்();
    உரைப்பு = கீழ்_எழுத்து(சொல்லாக்கு(குறியிட்டது));
    மொத்தம் = நீளம்(உரைப்பு);

    (மீதி(மொத்தம், 2) != 0) எனில் {
        திரும்பு தவறு("பதினாறு எழுத்துகள் இரட்டையாக இருக்க வேண்டும்  (hex needs an even number of characters)");
    }

    பைட்டு_அணி = [];
    எண்ணி = 0;
    (எண்ணி < மொத்தம்) சுற்று {
        மேல்_பாதி = தேடு(எழுத்துகள், உரைப்பு[எண்ணி]);
        கீழ்_பாதி = தேடு(எழுத்துகள், உரைப்பு[எண்ணி + 1]);
        (மேல்_பாதி < 0 அல்லது கீழ்_பாதி < 0) எனில் {
            திரும்பு தவறு("பதினாறில் இல்லாத எழுத்து: " & உரைப்பு[எண்ணி] & உரைப்பு[எண்ணி + 1]);
        }
        பைட்டு_அணி = இணை(பைட்டு_அணி, மேல்_பாதி * 16 + கீழ்_பாதி);
        எண்ணி = எண்ணி + 2;
    }

    திரும்பு பைட்டுச்_சரம்(பைட்டு_அணி);
}
