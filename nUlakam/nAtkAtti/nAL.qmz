// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Mohammed Maruff (Esan Maruff) <esan@etamil.in>
// nUlakam/nAtkAtti/nAL.qmz — நாள், the calendar itself
//
// Dates are ISO-8601 text, "YYYY-MM-DD", which sorts chronologically — so
// comparison, ordering and "is it in this period" need no arithmetic at all
// and live in kaNakkiyal/kAlam.qmz. What needs arithmetic is everything else,
// and the host provides exactly three primitives:
//
//     இன்று()                      today, in UTC
//     நாள்_வேறுபாடு(அ, ஆ)          whole days from அ to ஆ, negative if earlier
//     நாள்_கூட்டு(நாள், நாட்கள்)    a date shifted by whole days
//
// Everything here is built from those three. A month is not a fixed number of
// days and a year is not 365, so anything stated in months or years — an
// instalment date, a period of holding, interest "for every month or part of
// a month" — cannot be computed by dividing days by 30. That division is what
// this module exists to replace.
//
// **The host does not reject an impossible date.** நாள்_கூட்டு("2026-02-31", 0)
// answers "2026-03-03": the parser checks only that the month is 1-12 and the
// day 1-31, then rolls the overflow forward. So a date that came from outside
// the program has to go through நாள்_செல்லுபடியா before it is trusted, and
// that function deliberately does its own shape and range checks *before*
// handing anything to the host — because a month of 13 is not a தவறு there, it
// is a runtime error that stops the program.
//
// **Everything below assumes a valid date**, exactly as kAlam.qmz does.
// Validating inside every function would mean every function returned a
// Result, and a calendar whose every call has to be unwrapped is a calendar
// nobody will use. Validate at the edge — where the date arrives from a user,
// a file or a database — and the arithmetic stays readable.
//
// Weekdays are numbered **0 = Sunday** through 6 = Saturday, which is the
// numbering ISO-8601's own week rules are least like; it is chosen because
// மீதி is floor-based and this keeps the arithmetic free of adjustments.
// வாரநாள்_பெயர் exists so no caller has to remember it.
//
// Years outside 0001-9999 are not representable in the four-digit form and are
// not supported.

இறக்கு "../kaNiqam.qmz";
இறக்கு "../col.qmz";

// The epoch the host counts from, and the weekday it fell on. 1 January 1970
// was a Thursday, which is day 4 when Sunday is 0.
செயல் காலத்_தொடக்கம்() { திரும்பு "1970-01-01"; }

// =========================================================================
// செல்லுபடி — is this a date at all
// =========================================================================
//
// நாள்_வடிவமா(நாள்_உரை) — the shape, checked without touching the host
//
// Ten characters, dashes in the fifth and eighth position, digits everywhere
// else. This runs first and on its own, because the host's parser raises a
// runtime error rather than a தவறு for anything it cannot read, and a library
// that stops the program when handed a malformed string is not usable at the
// edge of a system, which is the only place malformed strings arrive.
செயல் நாள்_வடிவமா(நாள்_உரை) {
    // வகை answers in English, so the name compared here is "a string"
    // and not the Tamil word. Surprising, and checked by the tests.
    (வகை(நாள்_உரை) != "a string") எனில் { திரும்பு பொய்; }
    (நீளம்(நாள்_உரை) != 10) எனில் { திரும்பு பொய்; }
    (எழுத்து(நாள்_உரை, 4) != "-") எனில் { திரும்பு பொய்; }
    (எழுத்து(நாள்_உரை, 7) != "-") எனில் { திரும்பு பொய்; }

    எழுத்திடம் = 0;
    (எழுத்திடம் < 10) சுற்று {
        (எழுத்திடம் != 4 மற்றும் எழுத்திடம் != 7) எனில் {
            (இல்லை கொண்டுள்ளதா("0123456789", எழுத்து(நாள்_உரை, எழுத்திடம்))) எனில் {
                திரும்பு பொய்;
            }
        }
        எழுத்திடம் = எழுத்திடம் + 1;
    }
    திரும்பு மெய்;
}

// நாள்_செல்லுபடியா(நாள்_உரை) — and is it a day that exists
//
// Shape, then range, then the round trip. The round trip is the whole point:
// the host accepts 2026-02-31 and answers 2026-03-03, so a date that comes
// back different from the one that went in was never a real date. Thirty-first
// of February, thirtieth of February in a leap year, twenty-ninth in a common
// one — all caught by one comparison.
செயல் நாள்_செல்லுபடியா(நாள்_உரை) {
    (இல்லை நாள்_வடிவமா(நாள்_உரை)) எனில் { திரும்பு பொய்; }

    மாத_மதிப்பு = மதிப்பு(எண்ணாக்கு(துண்டு(நாள்_உரை, 5, 2)));
    நாள்_மதிப்பு = மதிப்பு(எண்ணாக்கு(துண்டு(நாள்_உரை, 8, 2)));

    // The host errors rather than returning a தவறு outside these ranges, so
    // they are checked here and not there.
    (மாத_மதிப்பு < 1 அல்லது மாத_மதிப்பு > 12) எனில் { திரும்பு பொய்; }
    (நாள்_மதிப்பு < 1 அல்லது நாள்_மதிப்பு > 31) எனில் { திரும்பு பொய்; }

    திரும்பு நாள்_கூட்டு(நாள்_உரை, 0) == நாள்_உரை;
}

// நாள்_சரிபார்(நாள்_உரை) — the same question, answered as a Result
//
// For the edge of a system, where the answer has to carry a reason.
செயல் நாள்_சரிபார்(நாள்_உரை) {
    (நாள்_செல்லுபடியா(நாள்_உரை)) எனில் { திரும்பு சரி(நாள்_உரை); }
    திரும்பு தவறு("செல்லாத நாள்  (not a valid date, expected YYYY-MM-DD): "
                   & சொல்லாக்கு(நாள்_உரை));
}

// =========================================================================
// கூறுகள் — the parts of a date
// =========================================================================

// நாளாக_வடிவமை(ஆண்டு_மதிப்பு, மாத_மதிப்பு, நாள்_மதிப்பு)
//
// Assembles the text without checking it. Used internally where the parts were
// computed rather than supplied, so they are known good; நாள்_ஆக்கு is the one
// that validates.
செயல் நாளாக_வடிவமை(ஆண்டு_மதிப்பு, மாத_மதிப்பு, நாள்_மதிப்பு) {
    திரும்பு இடமிருந்து_நிரப்பு(சொல்லாக்கு(ஆண்டு_மதிப்பு), 4, "0") & "-"
             & இடமிருந்து_நிரப்பு(சொல்லாக்கு(மாத_மதிப்பு), 2, "0") & "-"
             & இடமிருந்து_நிரப்பு(சொல்லாக்கு(நாள்_மதிப்பு), 2, "0");
}

// நாள்_ஆக்கு(ஆண்டு_மதிப்பு, மாத_மதிப்பு, நாள்_மதிப்பு) — the constructor
செயல் நாள்_ஆக்கு(ஆண்டு_மதிப்பு, மாத_மதிப்பு, நாள்_மதிப்பு) {
    திரும்பு நாள்_சரிபார்(நாளாக_வடிவமை(ஆண்டு_மதிப்பு, மாத_மதிப்பு,
                                          நாள்_மதிப்பு));
}

செயல் ஆண்டைப்_பெறு(ஒரு_நாள்) {
    திரும்பு மதிப்பு(எண்ணாக்கு(துண்டு(ஒரு_நாள், 0, 4)));
}

செயல் மாதத்தைப்_பெறு(ஒரு_நாள்) {
    திரும்பு மதிப்பு(எண்ணாக்கு(துண்டு(ஒரு_நாள், 5, 2)));
}

செயல் நாளைப்_பெறு(ஒரு_நாள்) {
    திரும்பு மதிப்பு(எண்ணாக்கு(துண்டு(ஒரு_நாள், 8, 2)));
}

// =========================================================================
// மாதங்களும் ஆண்டுகளும் — months and years
// =========================================================================
//
// நெட்டாண்டா(ஆண்டு_மதிப்பு) — a leap year
//
// Divisible by four, except centuries, except every fourth century. 1900 was
// not a leap year and 2000 was, and any rule that stops at "divisible by four"
// gets one of those two wrong.
செயல் நெட்டாண்டா(ஆண்டு_மதிப்பு) {
    (மீதி(ஆண்டு_மதிப்பு, 400) == 0) எனில் { திரும்பு மெய்; }
    (மீதி(ஆண்டு_மதிப்பு, 100) == 0) எனில் { திரும்பு பொய்; }
    திரும்பு மீதி(ஆண்டு_மதிப்பு, 4) == 0;
}

// மாத_நாட்கள்(ஆண்டு_மதிப்பு, மாத_மதிப்பு)
செயல் மாத_நாட்கள்(ஆண்டு_மதிப்பு, மாத_மதிப்பு) {
    (மாத_மதிப்பு == 2) எனில் {
        (நெட்டாண்டா(ஆண்டு_மதிப்பு)) எனில் { திரும்பு 29; }
        திரும்பு 28;
    }
    (மாத_மதிப்பு == 4 அல்லது மாத_மதிப்பு == 6 அல்லது மாத_மதிப்பு == 9
     அல்லது மாத_மதிப்பு == 11) எனில் { திரும்பு 30; }
    திரும்பு 31;
}

// மாத_முதல்(ஒரு_நாள்) / மாத_இறுதி(ஒரு_நாள்)
செயல் மாத_முதல்(ஒரு_நாள்) {
    திரும்பு நாளாக_வடிவமை(ஆண்டைப்_பெறு(ஒரு_நாள்),
                            மாதத்தைப்_பெறு(ஒரு_நாள்), 1);
}

செயல் மாத_இறுதி(ஒரு_நாள்) {
    ஆண்டு_மதிப்பு = ஆண்டைப்_பெறு(ஒரு_நாள்);
    மாத_மதிப்பு = மாதத்தைப்_பெறு(ஒரு_நாள்);
    திரும்பு நாளாக_வடிவமை(ஆண்டு_மதிப்பு, மாத_மதிப்பு,
                            மாத_நாட்கள்(ஆண்டு_மதிப்பு, மாத_மதிப்பு));
}

செயல் மாத_இறுதியா(ஒரு_நாள்) {
    திரும்பு ஒரு_நாள் == மாத_இறுதி(ஒரு_நாள்);
}

// மாதங்களைக்_கூட்டு(ஒரு_நாள், மாத_எண்ணிக்கை)
//
// Adding a month is not adding thirty days, and the difference is the last few
// days of every long month. The 31st of January plus one month is the 28th of
// February — there is no 31st — and the rule is to **clamp to the end of the
// target month** rather than to roll over into March.
//
// Clamping is not reversible, and that is a property of the calendar rather
// than a defect here: 31 January plus one month is 28 February, and 28
// February minus one month is 28 January. A schedule generated by repeatedly
// adding one month to the *previous* result therefore drifts — 31 Jan, 28 Feb,
// 28 Mar — while one generated by adding n months to the *original* does not.
// Always count from the original.
//
// A negative count subtracts.
செயல் மாதங்களைக்_கூட்டு(ஒரு_நாள், மாத_எண்ணிக்கை) {
    ஆண்டு_மதிப்பு = ஆண்டைப்_பெறு(ஒரு_நாள்);
    மாத_மதிப்பு = மாதத்தைப்_பெறு(ஒரு_நாள்);
    நாள்_மதிப்பு = நாளைப்_பெறு(ஒரு_நாள்);

    // Count months from year zero so that மீதி never sees a negative.
    ஓட்டு_மாதம் = ஆண்டு_மதிப்பு * 12 + (மாத_மதிப்பு - 1) + மாத_எண்ணிக்கை;
    புது_ஆண்டு = தரை(ஓட்டு_மாதம் / 12);
    புது_மாதம் = மீதி(ஓட்டு_மாதம், 12) + 1;

    உச்ச_நாள் = மாத_நாட்கள்(புது_ஆண்டு, புது_மாதம்);
    (நாள்_மதிப்பு > உச்ச_நாள்) எனில் { நாள்_மதிப்பு = உச்ச_நாள்; }

    திரும்பு நாளாக_வடிவமை(புது_ஆண்டு, புது_மாதம், நாள்_மதிப்பு);
}

// ஆண்டுகளைக்_கூட்டு(ஒரு_நாள், ஆண்டு_எண்ணிக்கை)
//
// Through months, so that the 29th of February clamps to the 28th in a common
// year instead of becoming the 1st of March.
செயல் ஆண்டுகளைக்_கூட்டு(ஒரு_நாள், ஆண்டு_எண்ணிக்கை) {
    திரும்பு மாதங்களைக்_கூட்டு(ஒரு_நாள், ஆண்டு_எண்ணிக்கை * 12);
}

// =========================================================================
// இடைவெளிகள் — how long between two dates
// =========================================================================
//
// முடிந்த_மாதங்கள்(தொடக்கம், முடிவு) — whole months completed
//
// The count of calendar months from one date to another, ignoring the part
// month at the end. Gratuity, a period of holding, a loan tenor and a notice
// period are all stated this way, and none of them is days divided by thirty:
// from 31 January to 28 February is one completed month, and 28 days.
//
// The end-of-month rule matters. 31 January to 28 February is a full month
// because the 28th is as late as February goes — clamping made the target
// date, so the target date counts as reached. Without that rule, a monthly
// obligation starting on the 31st would never complete a month in February.
செயல் முடிந்த_மாதங்கள்(தொடக்கம், முடிவு) {
    (நாள்_வேறுபாடு(தொடக்கம், முடிவு) <= 0) எனில் { திரும்பு 0; }

    கச்சா = (ஆண்டைப்_பெறு(முடிவு) * 12 + மாதத்தைப்_பெறு(முடிவு))
             - (ஆண்டைப்_பெறு(தொடக்கம்) * 12 + மாதத்தைப்_பெறு(தொடக்கம்));

    // The day of the month has not come round yet, unless the month ran out
    // first — in which case its last day is the day it came round on.
    (நாளைப்_பெறு(முடிவு) < நாளைப்_பெறு(தொடக்கம்)
     மற்றும் இல்லை மாத_இறுதியா(முடிவு)) எனில் {
        கச்சா = கச்சா - 1;
    }
    (கச்சா < 0) எனில் { திரும்பு 0; }
    திரும்பு கச்சா;
}

// முடிந்த_ஆண்டுகள்(தொடக்கம், முடிவு) — whole years completed
//
// Somebody's age, and the number of completed years of service that gratuity
// is paid on.
செயல் முடிந்த_ஆண்டுகள்(தொடக்கம், முடிவு) {
    திரும்பு தரை(முடிந்த_மாதங்கள்(தொடக்கம், முடிவு) / 12);
}

// பகுதி_மாதங்கள்(தொடக்கம், முடிவு) — months, counting a part month as whole
//
// This is the rule the Income Tax Act's interest sections use — "for every
// month or part of a month" — and it is the reason muZvari.qmz and
// mUlavari.qmz take a count of months rather than a pair of dates. One day
// into a new month is a whole month's interest.
//
// It is **calendar** months, not days divided by thirty and rounded up, and
// the two disagree on any month of 31 days: 1 January to 1 February is one
// month here and 31/30 rounded up — two — by the division. Seven months of
// twelve are long, so the error accumulates rather than averaging out, and a
// full year is twelve months by this rule against thirteen by the division.
// The division always overcharges and never under-charges, which is why it
// survives review: nobody disputes an interest computation in their favour.
செயல் பகுதி_மாதங்கள்(தொடக்கம், முடிவு) {
    (நாள்_வேறுபாடு(தொடக்கம், முடிவு) <= 0) எனில் { திரும்பு 0; }

    முழுமை = முடிந்த_மாதங்கள்(தொடக்கம், முடிவு);
    (மாதங்களைக்_கூட்டு(தொடக்கம், முழுமை) == முடிவு) எனில் { திரும்பு முழுமை; }
    திரும்பு முழுமை + 1;
}

// முந்தையது(அ, ஆ) / பிந்தையது(அ, ஆ) — the earlier and the later
//
// ISO-8601 text sorts chronologically, so this is a string comparison and
// needs no arithmetic. That is the whole reason the format was chosen.
செயல் முந்தையது(அ, ஆ) {
    (அ <= ஆ) எனில் { திரும்பு அ; }
    திரும்பு ஆ;
}

செயல் பிந்தையது(அ, ஆ) {
    (அ >= ஆ) எனில் { திரும்பு அ; }
    திரும்பு ஆ;
}

// =========================================================================
// வாரநாள் — the day of the week
// =========================================================================
//
// வாரநாள்(ஒரு_நாள்) — 0 = Sunday through 6 = Saturday
//
// Derived from the epoch, which was a Thursday. மீதி floors, so this is
// correct for dates before 1970 as well — 31 December 1969 answers 3, a
// Wednesday, without a special case.
செயல் வாரநாள்(ஒரு_நாள்) {
    திரும்பு மீதி(நாள்_வேறுபாடு(காலத்_தொடக்கம்(), ஒரு_நாள்) + 4, 7);
}

செயல் வாரநாள்_பெயர்(வாரநாள்_எண்) {
    (வாரநாள்_எண் == 0) எனில் { திரும்பு "ஞாயிறு"; }
    (வாரநாள்_எண் == 1) எனில் { திரும்பு "திங்கள்"; }
    (வாரநாள்_எண் == 2) எனில் { திரும்பு "செவ்வாய்"; }
    (வாரநாள்_எண் == 3) எனில் { திரும்பு "புதன்"; }
    (வாரநாள்_எண் == 4) எனில் { திரும்பு "வியாழன்"; }
    (வாரநாள்_எண் == 5) எனில் { திரும்பு "வெள்ளி"; }
    (வாரநாள்_எண் == 6) எனில் { திரும்பு "சனி"; }
    திரும்பு "";
}

// =========================================================================
// நிதியாண்டு — the financial year
// =========================================================================
//
// நிதியாண்டின்_தொடக்க_ஆண்டு(ஒரு_நாள், தொடக்க_மாதம்)
//
// Which financial year a date falls in, named by the calendar year it starts
// in. India's begins in April, so the 14th of March 2026 belongs to the year
// that began in April 2025 and is called 2025-26.
//
// The starting month is a parameter because it is not universal: the United
// Kingdom's corporation tax year begins in April too but its personal tax year
// begins on the 6th, Australia's begins in July, and a company's own financial
// year may begin anywhere its articles say.
செயல் நிதியாண்டின்_தொடக்க_ஆண்டு(ஒரு_நாள், தொடக்க_மாதம்) {
    (மாதத்தைப்_பெறு(ஒரு_நாள்) >= தொடக்க_மாதம்) எனில் {
        திரும்பு ஆண்டைப்_பெறு(ஒரு_நாள்);
    }
    திரும்பு ஆண்டைப்_பெறு(ஒரு_நாள்) - 1;
}

// கால்_ஆண்டு_எண்(ஒரு_நாள், தொடக்க_மாதம்) — which quarter, 1 to 4
//
// Counted from the financial year's own start, so with an April start July is
// in the second quarter and not the third. A report that quarters the calendar
// while the accounts quarter the financial year disagrees with the accounts
// three times in four.
செயல் கால்_ஆண்டு_எண்(ஒரு_நாள், தொடக்க_மாதம்) {
    இடைவெளி_மாதம் = மீதி(மாதத்தைப்_பெறு(ஒரு_நாள்) - தொடக்க_மாதம், 12);
    திரும்பு தரை(இடைவெளி_மாதம் / 3) + 1;
}
