// nUlakam/kAcu.qmz — காசு: money as whole paise
//
// Two decimal places, exactly, without decimal arithmetic underneath.
//
// ₹2.05 is 205. Nothing in this file writes a fractional number, and that is
// the point: a double represents every integer below 2^53 exactly — about
// ₹90,000 crore expressed in paise — so adding, subtracting and multiplying
// money is exact even on a backend that has only floats. The LLVM backend
// computes in f64 and refuses fractional literals; a program written in paise
// is not asking it for anything it cannot do.
//
// On the VM this is simply a second way to hold money, and a good one for
// anything that must reconcile: an amount that is only ever a whole number of
// paise cannot acquire a fraction of one by accident.
//
// The one operation that needs care is division, and it is the reason the two
// interesting functions here exist:
//
//   விழுக்காடு_காசு  a percentage, rounded once rather than at every step
//   சமமாகப்_பிரி     a split that distributes the odd paise instead of losing
//                    them — the classic way money disappears from a ledger
//
// A note for the LLVM backend: division of a paise figure is the one step where
// a double can be out by one in the last place. Compiling whole numbers as i64
// and using integer division would make it exact, and that is a much smaller
// change than decimal arithmetic. See docs/llvm-backend-gaps.md.

இறக்கு "kaNiqam.qmz";

பைசா_ஒரு_ரூபாய் = 100;

// --- making it ------------------------------------------------------------
//
// ரூபாயும்_பைசாவும்(ரூபாய், பைசா) — ₹2.05 is ரூபாயும்_பைசாவும்(2, 5)
//
// Two whole numbers rather than one written 2.05, so that a program in paise
// never has a fractional literal in it anywhere.
செயல் ரூபாயும்_பைசாவும்(ரூபாய், பைசா) {
    திரும்பு ரூபாய் * பைசா_ஒரு_ரூபாய் + பைசா;
}

// ரூபாயாக(ரூபாய்) — whole rupees
செயல் ரூபாயாக(ரூபாய்) {
    திரும்பு ரூபாய் * பைசா_ஒரு_ரூபாய்;
}

// --- showing it -----------------------------------------------------------
//
// காசு_உரை(மொத்த_பைசா) — "2.05", built from the two halves rather than by
// dividing, so no fraction is ever produced to be formatted.
செயல் காசு_உரை(மொத்த_பைசா) {
    குறி = "";
    அளவு = மொத்த_பைசா;
    (மொத்த_பைசா < 0) எனில் {
        குறி = "-";
        அளவு = 0 - மொத்த_பைசா;
    }

    ரூபாய்ப்_பகுதி = தரை(அளவு / பைசா_ஒரு_ரூபாய்);
    பைசாப்_பகுதி = அளவு - ரூபாய்ப்_பகுதி * பைசா_ஒரு_ரூபாய்;

    (பைசாப்_பகுதி < 10) எனில் {
        திரும்பு குறி & ரூபாய்ப்_பகுதி & ".0" & பைசாப்_பகுதி;
    }
    திரும்பு குறி & ரூபாய்ப்_பகுதி & "." & பைசாப்_பகுதி;
}

// --- the exact operations -------------------------------------------------
//
// Addition, subtraction and multiplication by a count: exact on any backend,
// because whole numbers are exact in a double.
செயல் காசு_கூட்டு(அ, ஆ) { திரும்பு அ + ஆ; }
செயல் காசு_கழி(அ, ஆ) { திரும்பு அ - ஆ; }

// காசு_மடங்கு(மொத்த_பைசா, எண்ணிக்கை) — a price times a quantity
செயல் காசு_மடங்கு(மொத்த_பைசா, எண்ணிக்கை) {
    திரும்பு மொத்த_பைசா * எண்ணிக்கை;
}

// காசு_கூட்டல்(பட்டியல்) — a column of money
செயல் காசு_கூட்டல்(பட்டியல்) {
    கூட்டல் = 0;
    ஒவ்வொரு ஒன்று இல் பட்டியல் {
        கூட்டல் = கூட்டல் + ஒன்று;
    }
    திரும்பு கூட்டல்;
}

// --- the operation that needs rounding -----------------------------------
//
// விழுக்காடு_காசு(மொத்த_பைசா, மேல், கீழ்) — a rate as a fraction
//
// 18% is மேல்=18, கீழ்=100. A rate of 7.5% is 75 and 1000, because writing 7.5
// would be the fractional literal this whole approach avoids.
//
// Rounded half-up, once, at the end. Rounding at each step of a calculation is
// how a total stops matching the sum of its lines.
செயல் விழுக்காடு_காசு(மொத்த_பைசா, மேல், கீழ்) {
    (கீழ் == 0) எனில் { திரும்பு 0; }
    (மொத்த_பைசா < 0) எனில் {
        திரும்பு 0 - விழுக்காடு_காசு(0 - மொத்த_பைசா, மேல், கீழ்);
    }
    // + கீழ்/2 before dividing is half-up rounding done in whole numbers.
    திரும்பு தரை((மொத்த_பைசா * மேல் + தரை(கீழ் / 2)) / கீழ்);
}

// --- the split that does not lose paise ----------------------------------
//
// சமமாகப்_பிரி(மொத்த_பைசா, எத்தனை)
//
// Ten rupees three ways is 3.34, 3.33, 3.33 — not 3.33 three times, which
// loses a paisa, and not 3.34 three times, which invents one. The remainder is
// handed out one paisa at a time to the earliest shares.
//
// This is the classic way money disappears from a ledger: every share rounded
// the same way, and the total quietly short.
செயல் சமமாகப்_பிரி(மொத்த_பைசா, எத்தனை) {
    (எத்தனை <= 0) எனில் { திரும்பு []; }

    அடிப்படை = தரை(மொத்த_பைசா / எத்தனை);
    மீதம் = மொத்த_பைசா - அடிப்படை * எத்தனை;

    பங்குகள் = [];
    எண்ணி = 0;
    (எண்ணி < எத்தனை) சுற்று {
        இந்தப்_பங்கு = அடிப்படை;
        (எண்ணி < மீதம்) எனில் {
            இந்தப்_பங்கு = அடிப்படை + 1;
        }
        பங்குகள் = இணை(பங்குகள், இந்தப்_பங்கு);
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு பங்குகள்;
}

// --- splitting in proportion ---------------------------------------------
//
// விகிதத்தில்_பிரி(மொத்த_பைசா, எடைகள்)
//
// Apportioning a total by weights — a cost across departments, a duty across
// line items. Same discipline: the shares must add to the total, so the last
// one takes whatever is left rather than being rounded independently.
செயல் விகிதத்தில்_பிரி(மொத்த_பைசா, எடைகள்) {
    மொத்த_எடை = 0;
    ஒவ்வொரு ஒரு_எடை இல் எடைகள் {
        மொத்த_எடை = மொத்த_எடை + ஒரு_எடை;
    }
    (மொத்த_எடை <= 0) எனில் { திரும்பு []; }

    பங்குகள் = [];
    ஒதுக்கியது = 0;
    எண்ணி = 0;
    எத்தனை = நீளம்(எடைகள்);

    (எண்ணி < எத்தனை) சுற்று {
        (எண்ணி == எத்தனை - 1) எனில் {
            // The last share closes the total exactly.
            இந்தப்_பங்கு = மொத்த_பைசா - ஒதுக்கியது;
        }
        இன்றேல் {
            இந்தப்_பங்கு = தரை(மொத்த_பைசா * எடைகள்[எண்ணி] / மொத்த_எடை);
        }
        பங்குகள் = இணை(பங்குகள், இந்தப்_பங்கு);
        ஒதுக்கியது = ஒதுக்கியது + இந்தப்_பங்கு;
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு பங்குகள்;
}
