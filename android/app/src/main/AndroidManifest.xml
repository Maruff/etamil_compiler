<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The compiler is built with its `http-client` feature on, so `வேண்டு` can
      call an API. Without this the request fails at the socket with a
      permission error that looks like a network fault.

      Nothing else is asked for. The app reads and writes only its own private
      directory, which needs no permission on any Android version.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The icon below is a vector, not the usual set of five PNG densities: a
      placeholder icon that is one readable text file beats five binaries nobody
      can review in a diff. Replace it with a real icon set before publishing
      anywhere.

      This note sits above the element rather than beside the attribute it
      describes because XML does not allow a comment inside a start tag. One
      there fails the build at :app:processDebugMainManifest, and the manifest
      merger reports it only as "Error parsing AndroidManifest.xml" with no line
      number, which is a long way from the actual mistake.
    -->
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ETamil">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
