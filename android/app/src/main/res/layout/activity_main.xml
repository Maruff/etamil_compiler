<?xml version="1.0" encoding="utf-8"?>
<!--
  Source on top, output below, controls between them.

  The source box and the output box each take half of what is left after the
  controls, using layout_weight, so neither can grow until the other is
  unusable. On a phone that matters more than it sounds: an error message in
  Tamil and English is a long line, and an output pane sized to its content
  would push the editor off the screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <EditText
        android:id="@+id/source"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="@string/hint_source"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:textSize="14sp"
        android:autofillHints="" />

    <EditText
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:hint="@string/hint_input"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:maxLines="3"
        android:textSize="13sp"
        android:autofillHints="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/run"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_run" />

        <Button
            android:id="@+id/check"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/action_check" />

        <Button
            android:id="@+id/examples"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/action_examples" />
    </LinearLayout>

    <!--
      The output pane scrolls on its own. A program that prints a hundred lines
      should not scroll the editor away to show them.
    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

</LinearLayout>
