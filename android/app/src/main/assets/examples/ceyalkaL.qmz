// செயல்கள் — functions, results and the ? operator
//
// Failure is a value here, as in Rust: a செயல் that can fail returns
// சரி(மதிப்பு) or தவறு(காரணம்), and ? hands a failure to the caller.

// Recursion
செயல் காரணீயம்(எண்_மதிப்பு) {
    (எண்_மதிப்பு <= 1) எனில் { திரும்பு 1; }
    திரும்பு எண்_மதிப்பு * காரணீயம்(எண்_மதிப்பு - 1);
}

// A function that can fail
செயல் வகு(மேல், கீழ்) {
    (கீழ் == 0) எனில் {
        திரும்பு தவறு("பூஜ்ஜியத்தால் வகுக்க முடியாது");
    }
    திரும்பு சரி(மேல் / கீழ்);
}

// ? propagates the failure without any explicit check
செயல் சராசரி_விலை(மொத்தம், எண்ணிக்கை) {
    ஒன்று = வகு(மொத்தம், எண்ணிக்கை)?;
    திரும்பு சரி(வட்டமிடு(ஒன்று, 2));
}

அச்சு "காரணீயம்(6) = " & காரணீயம்(6);

நல்லது = சராசரி_விலை(1000, 3);
அச்சு "சராசரி (1000/3) = " & மதிப்பு(நல்லது);

கெட்டது = சராசரி_விலை(1000, 0);
(தவறா(கெட்டது)) எனில் {
    அச்சு "எதிர்பார்த்த தவறு பிடிபட்டது";
}

// இயல்பு supplies a fallback instead of failing
அச்சு "இயல்பு மதிப்புடன்: " & இயல்பு(சராசரி_விலை(10, 0), 0);
