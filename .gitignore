test_output/
*.test

# Environment files
.env
.env.local

# Release packages. These are published as GitHub release assets, never
# committed: a binary in git history is permanent and every clone pays for it.
dist/

# Written by the io_samples examples when they run. run_parity.sh runs each
# example beside itself so that a relative data-file path resolves, unlike
# run_examples.sh which runs in a temp directory — so a parity run leaves
# these behind. input.txt, numbers.txt, sample.txt and tamil_sample.txt are
# inputs and stay tracked.
examples/io_samples/data.txt
examples/io_samples/output.txt
examples/io_samples/transactions.csv

# Python bytecode from scripts/. Reappears after every run of the
# generators and the parity checks.
__pycache__/

# Written by examples/crypto_samples/maRYyAkkam.qmz when it runs.
*.enc

# --- Android app ---
# The JNI shim's own Rust build directory, alongside the compiler's above.
android/rust/target/
# Gradle's build output and local state. The APK is a release asset or a CI
# artifact, never a commit, for the same reason dist/ is not committed.
android/build/
android/app/build/
android/.gradle/
android/local.properties
# Produced by cargo-ndk on the way to an APK. One .so per ABI, several
# megabytes each, and rebuilt from the Rust source every time — nothing a
# clone should be paying to download.
android/app/src/main/jniLibs/
