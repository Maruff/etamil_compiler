    given-names: Mohammed
    alias: "Esan Maruff"
    email: esan@etamil.in
    affiliation: >-
      Department of Computer Applications, School of Computer Information and
      Mathematical Sciences, B.S. Abdur Rahman Crescent Institute of Science and
      Technology, Vandalur, Chennai, India
    # Add an ORCID iD here once registered — it is free at https://orcid.org and
    # is what ties the papers, the thesis and this software to one identity.
    # orcid: "https://orcid.org/0000-0000-0000-0000"

repository-code: "https://github.com/Maruff/etamil_compiler"
url: "https://etamil.in"
license: AGPL-3.0-or-later
version: "0.4.0"

keywords:
  - domain-specific language
  - programming language
  - Tamil
  - transliteration
  - romanization
  - fintech
  - GST
  - accounting
  - taxation
  - India
  - compiler
