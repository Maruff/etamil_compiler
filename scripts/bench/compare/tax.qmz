// The slab-tax loop, N times. Exact decimal throughout.
//
// N arrives on stdin because eTamil has no argv. That also keeps the loop
// bound out of the source, which is what stops the C and Rust versions of this
// benchmark being folded to a constant at compile time.
//
// The conversion on the next line is load-bearing. உள்ளிடு yields *text*, and
// comparison coerces text to a number rather than refusing — so leaving it as
// text made `i < eNNikkY` re-parse the string with Decimal::from_str on every
// single iteration. That inflated the measured cost of this loop by more than
// half, and it was the benchmark's fault, not the VM's.
uLLitu eNNikkY;
eNNikkY = iyalpu(eNNAkku(eNNikkY), 0);

moqqam = 0;
i = 0;
(i < eNNikkY) cuRRu {
    varumAZam = 300000 + i;
    vari = (varumAZam - 300000) * 5%;
    moqqam = moqqam + vari;
    i = i + 1;
}
accu moqqam;
