// __Status Monitor Server__
// __Demonstrates conditional logic__
// __Run: ./etamil_compiler --server --port 8080 status_server.qmz__

எண் _cpu_usage;
எண் _memory_usage;
எண் _disk_usage;
எண் _status_code;

_cpu_usage = 45;
_memory_usage = 62;
_disk_usage = 78;

(_cpu_usage > 80) எனில் {
    அச்சு "High CPU";
}
இன்றேல் {
    அச்சு "Normal CPU";
}

(_memory_usage > 80) எனில் {
    அச்சு "High Memory";
}
இன்றேல் {
    அச்சு "Normal Memory";
}

(_disk_usage > 90) எனில் {
    அச்சு "Critical Disk";
    _status_code = 500;
}
இன்றேல் {
    அச்சு "Disk OK";
    _status_code = 200;
}

அச்சு "Status: " & _status_code;
