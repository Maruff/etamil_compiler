// __Simple API Server__
// __Demonstrates basic HTTP server capabilities__
// __Run: ./etamil_compiler --server --port 8080 simple_api.qmz__

எண் _api_version;
எண் _uptime_seconds;

_api_version = 1;
_uptime_seconds = 3600;

அச்சு "API Server v" & _api_version & " started";
அச்சு "Uptime: " & _uptime_seconds & " seconds";
