// __User Management Server__
// __Demonstrates calculation and variable management__
// __Run: ./etamil_compiler --server --port 8080 user_server.qmz__

எண் _total_users;
எண் _active_users;
எண் _inactive_users;
எண் _premium_users;

_total_users = 1000;
_active_users = 750;
_inactive_users = 200;
_premium_users = 50;

அச்சு "User Management Server";
அச்சு "Total: " & _total_users;
அச்சு "Active: " & _active_users;
அச்சு "Premium: " & _premium_users;
