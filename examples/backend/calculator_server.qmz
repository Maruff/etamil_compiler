// __Calculator Server__
// __Demonstrates mathematical operations__
// __Run: ./etamil_compiler --server --port 8080 calculator_server.qmz__

எண் _a;
எண் _b;
எண் _sum;
எண் _product;
எண் _difference;

_a = 100;
_b = 25;

_sum = _a + _b;
_product = _a * _b;
_difference = _a - _b;

அச்சு "Calculator Server";
அச்சு "a = " & _a;
அச்சு "b = " & _b;
அச்சு "a + b = " & _sum;
அச்சு "a * b = " & _product;
அச்சு "a - b = " & _difference;
