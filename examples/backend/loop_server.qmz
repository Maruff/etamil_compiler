// __Loop Server__
// __Demonstrates loop structures__
// __Run: ./etamil_compiler --server --port 8080 loop_server.qmz__

எண் _counter;
எண் _sum;

_counter = 0;
_sum = 0;

(_counter < 5) சுற்று {
    _sum = _sum + _counter;
    _counter = _counter + 1;
}

அச்சு "Loop Server";
அச்சு "Final counter: " & _counter;
அச்சு "Sum of 0-4: " & _sum;
