// examples/kadai/kadai.qmz — கடை: an online shop's pricing and GST
//
// Definitions only; kadai_kAttu.qmz runs them and kadai_cEvY.qmz serves them.
//
// GST is computed **per line**, not on the invoice total, because an order can
// mix rates — 5% on a saree and 18% on a phone case — and taxing the sum at
// one rate would be wrong on both. Each line's tax is split into CGST/SGST or
// IGST and the splits are accumulated, which is what a GST return expects.
//
// Note how many of these names are also keywords: விலை, இருப்பு, வரி, சரக்கு,
// விலைப்பட்டியல். They are the words a shop actually uses, and they keep the
// spelling written here — before roadmap item 2 they would have been stored as
// Price, Balance, Tax, Goods and Invoice.

இறக்கு "../../nUlakam/paNam.qmz";
இறக்கு "../../nUlakam/kaNiqam.qmz";
இறக்கு "../../nUlakam/col.qmz";
இறக்கு "../../nUlakam/kaNakkiyal/vari.qmz";

// --- Accounts -------------------------------------------------------------
// A shop's books. The codes are what the ledger posts against.

செயல் கணக்கு_வங்கி()          { திரும்பு "1000"; }
செயல் கணக்கு_வாடிக்கையாளர்() { திரும்பு "1100"; }
செயல் கணக்கு_சரக்கிருப்பு()   { திரும்பு "1200"; }
செயல் கணக்கு_வரி_செலுத்த()    { திரும்பு "2100"; }
செயல் கணக்கு_மூலதனம்()        { திரும்பு "3000"; }
செயல் கணக்கு_விற்பனை()        { திரும்பு "4000"; }
செயல் கணக்கு_விற்ற_செலவு()    { திரும்பு "5000"; }

செயல் கடை_கணக்குகள்() {
    திரும்பு [
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_வங்கி(), "வங்கி", "சொத்து", "நடப்பு")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_வாடிக்கையாளர்(), "வாடிக்கையாளர்கள்", "சொத்து", "நடப்பு")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_சரக்கிருப்பு(), "சரக்கிருப்பு", "சொத்து", "நடப்பு")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_வரி_செலுத்த(), "வணிகவரி செலுத்தவேண்டியது", "பொறுப்பு", "நடப்பு")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_மூலதனம்(), "மூலதனம்", "பங்கு", "மூலதனம்")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_விற்பனை(), "விற்பனை", "வருவாய்", "இயக்கம்")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_விற்ற_செலவு(), "விற்ற பொருளின் செலவு", "செலவு", "இயக்கம்"))
    ];
}

// --- The cart -------------------------------------------------------------

// வண்டி_ஒரு_வரிசை(...) — one line of a cart
செயல் வண்டி_ஒரு_வரிசை(சரக்கு_குறி, பெயர், அலகு_விலை, அளவு, வரி_விகிதம்) {
    திரும்பு {
        சரக்கு_குறி: சரக்கு_குறி,
        பெயர்: பெயர்,
        அலகு_விலை: அலகு_விலை,
        அளவு: அளவு,
        வரி_விகிதம்: வரி_விகிதம்
    };
}

// ஒரு_வரிசை_அடிப்படை(ஒரு_வரிசை) — the line's value before tax
செயல் ஒரு_வரிசை_அடிப்படை(ஒரு_வரிசை) {
    திரும்பு ஒரு_வரிசை.அலகு_விலை * ஒரு_வரிசை.அளவு;
}

// வண்டி_கணக்கு(வரிசைகள், உள்_மாநிலமா) — what the customer owes, and how the
// tax divides.
//
// உள்_மாநிலமா decides the split, not the amount: within a state the tax is
// half CGST and half SGST; across states the whole of it is IGST. Getting this
// wrong misfiles the return even when the total is right.
செயல் வண்டி_கணக்கு(வண்டி_வரிசைகள், உள்_மாநிலமா) {
    அடிப்படை_மொத்தம் = 0;
    cgst_மொத்தம் = 0;
    sgst_மொத்தம் = 0;
    igst_மொத்தம் = 0;

    ஒவ்வொரு ஒரு_வரிசை இல் வண்டி_வரிசைகள் {
        வரிசை_அடிப்படை = ஒரு_வரிசை_அடிப்படை(ஒரு_வரிசை);
        வரிசை_வரி = வட்டமிடு(சதவீதம்(வரிசை_அடிப்படை, ஒரு_வரிசை.வரி_விகிதம்), 2);
        பிரிப்பு = மாநில_பிரிப்பு(வரிசை_வரி, உள்_மாநிலமா);

        அடிப்படை_மொத்தம் = அடிப்படை_மொத்தம் + வரிசை_அடிப்படை;
        cgst_மொத்தம் = cgst_மொத்தம் + பிரிப்பு.cgst;
        sgst_மொத்தம் = sgst_மொத்தம் + பிரிப்பு.sgst;
        igst_மொத்தம் = igst_மொத்தம் + பிரிப்பு.igst;
    }

    வரி_மொத்தம் = cgst_மொத்தம் + sgst_மொத்தம் + igst_மொத்தம்;
    திரும்பு {
        அடிப்படை: அடிப்படை_மொத்தம்,
        cgst: cgst_மொத்தம்,
        sgst: sgst_மொத்தம்,
        igst: igst_மொத்தம்,
        வரி: வரி_மொத்தம்,
        செலுத்தவேண்டியது: அடிப்படை_மொத்தம் + வரி_மொத்தம்
    };
}

// --- The invoice ----------------------------------------------------------

செயல் விலைப்பட்டியல்_அச்சிடு(விலைப்பட்டியல்_எண், வாடிக்கையாளர்_பெயர்,
                                நாள், வண்டி_வரிசைகள், கணக்கு) {
    அச்சு "====================================================";
    அச்சு "  விலைப்பட்டியல் " & விலைப்பட்டியல்_எண் & "        " & நாள்;
    அச்சு "  வாடிக்கையாளர்: " & வாடிக்கையாளர்_பெயர்;
    அச்சு "====================================================";
    அச்சு "  பொருள்                அளவு      விலை       தொகை";
    அச்சு "----------------------------------------------------";

    ஒவ்வொரு ஒரு_வரிசை இல் வண்டி_வரிசைகள் {
        அச்சு "  " & இடமிருந்து_நிரப்பு(ஒரு_வரிசை.பெயர், 20, " ")
              & "  " & இடமிருந்து_நிரப்பு(சொல்லாக்கு(ஒரு_வரிசை.அளவு), 4, " ")
              & "  " & இடமிருந்து_நிரப்பு(ரூபாய்(ஒரு_வரிசை.அலகு_விலை), 12, " ")
              & "  " & ரூபாய்(ஒரு_வரிசை_அடிப்படை(ஒரு_வரிசை))
              & "   (" & ஒரு_வரிசை.வரி_விகிதம் & "%)";
    }

    அச்சு "----------------------------------------------------";
    அச்சு "  வரிக்கு முன்                    " & ரூபாய்(கணக்கு.அடிப்படை);
    (கணக்கு.igst > 0) எனில் {
        அச்சு "  IGST                            " & ரூபாய்(கணக்கு.igst);
    }
    இன்றேல் {
        அச்சு "  CGST                            " & ரூபாய்(கணக்கு.cgst);
        அச்சு "  SGST                            " & ரூபாய்(கணக்கு.sgst);
    }
    அச்சு "====================================================";
    அச்சு "  செலுத்தவேண்டியது                " & ரூபாய்(கணக்கு.செலுத்தவேண்டியது);
    அச்சு "====================================================";
}
