// __Student Management System Example__
// __Demonstrates database operations with eTamil__
// 
// __This program shows:__
// __1. Creating tables for students__
// __2. Inserting student records__
// __3. Querying student data__
// __4. Updating grades__
// __5. Reading/writing encrypted data__

எண் student_id = 0;
எண் total_students = 0;
எண் _total_score = 0;

// __Create students database__
கோப்பு_திற "students.csv", "write";
கோப்பு_எழுது "students.csv", 1001;
கோப்பு_எழுது "students.csv", 1002;
கோப்பு_எழுது "students.csv", 1003;
கோப்பு_மூடு "students.csv";

// __Write student data__
தரவுரை_எழுது "students.csv", "student_id,name,score";
தரவுரை_எழுது "students.csv", "1001,ராஜா,95";
தரவுரை_எழுது "students.csv", "1002,தேவி,88";
தரவுரை_எழுது "students.csv", "1003,குமார்,92";

// __Read student data__
கோப்பு_திற "students.csv", "read";
தரவுரை_படி "students.csv", total_students;

// __Calculate total__
_total_score = 95 + 88 + 92;

// __Display results__
அச்சு "Total Students: ";
அச்சு total_students;

அச்சு "Total Score: ";
அச்சு _total_score;

// __Close file__
கோப்பு_மூடு "students.csv";
