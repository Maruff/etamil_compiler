// மைசீகுல் தளம் — a ledger in MySQL / MariaDB
//
// Placeholders are `?`, as in SQLite, not PostgreSQL's `$1`. Queries are
// always parameterised: values are bound by the driver, never spliced into
// the SQL text.
//
// Needs a build with the driver and a reachable server:
//
//   cargo build --release --features mysql
//   mysql -u root -e "CREATE DATABASE IF NOT EXISTS kaNakku"
//   ETAMIL_MYSQL_URL=... etamil --vm examples/db_samples/mYcIkul_qaLam.qmz
//
// The URL is written into the இணை line below; edit it for your server.

இறக்கு "../../nUlakam/paNam.qmz";
இறக்கு "../../nUlakam/kaNiqam.qmz";
இறக்கு "../../nUlakam/aNi.qmz";

தளம்_இணை மைசீகுல், "mysql://root@localhost:3306/kaNakku";

தளம்_செய் "DROP TABLE IF EXISTS pativukaL", [];

// DECIMAL, not DOUBLE: a ledger has to balance to the paisa, and MySQL's
// DOUBLE is binary floating point.
தளம்_செய் "CREATE TABLE pativukaL (
              id INT AUTO_INCREMENT PRIMARY KEY,
              peyar VARCHAR(64) NOT NULL,
              vakY VARCHAR(32) NOT NULL,
              qokY DECIMAL(14,2) NOT NULL,
              naaL DATE NULL) CHARACTER SET utf8mb4", [];

தளம்_செய் "INSERT INTO pativukaL (peyar, vakY, qokY, naaL) VALUES (?, ?, ?, ?)",
          ["வாடகை", "செலவு", 25000, "2026-04-01"];
தளம்_செய் "INSERT INTO pativukaL (peyar, vakY, qokY, naaL) VALUES (?, ?, ?, ?)",
          ["விற்பனை", "வரவு", 184500.25, "2026-04-02"];
தளம்_செய் "INSERT INTO pativukaL (peyar, vakY, qokY, naaL) VALUES (?, ?, ?, ?)",
          ["மின்கட்டணம்", "செலவு", 4200.75, "2026-04-03"];
தளம்_செய் "INSERT INTO pativukaL (peyar, vakY, qokY, naaL) VALUES (?, ?, ?, ?)",
          ["ஆலோசனை", "வரவு", 62000, "2026-04-05"];

தளம்_வினா "SELECT peyar, qokY, naaL FROM pativukaL
           WHERE vakY = ? ORDER BY qokY DESC", ["வரவு"], வரவுகள்;

அச்சு "வரவுகள்";
அச்சு "---------------------------------";
ஒவ்வொரு ஒரு_பதிவு இல் வரவுகள் {
    அச்சு "  " & ஒரு_பதிவு.naaL & "  " & ஒரு_பதிவு.peyar & " — " & ரூபாய்(ஒரு_பதிவு.qokY);
}

தளம்_வினா "SELECT peyar, qokY FROM pativukaL WHERE vakY = ?", ["செலவு"], செலவுகள்;

அச்சு "";
அச்சு "செலவுகள்";
அச்சு "---------------------------------";
ஒவ்வொரு ஒரு_பதிவு இல் செலவுகள் {
    அச்சு "  " & ஒரு_பதிவு.peyar & " — " & ரூபாய்(ஒரு_பதிவு.qokY);
}

மொத்த_வரவு = கூட்டு(புலம்_எடு(வரவுகள், "qokY"));
மொத்த_செலவு = கூட்டு(புலம்_எடு(செலவுகள், "qokY"));

அச்சு "";
அச்சு "=================================";
அச்சு "மொத்த வரவு : " & ரூபாய்(மொத்த_வரவு);
அச்சு "மொத்த செலவு: " & ரூபாய்(மொத்த_செலவு);
அச்சு "நிகர இருப்பு: " & ரூபாய்(மொத்த_வரவு - மொத்த_செலவு);

// --- The things worth checking on a real server -------------------------

அச்சு "";
அச்சு "=== சரிபார்ப்பு (checks) ===";

// DECIMAL keeps its precision: these must be exact, not 0.30000000000000004.
தளம்_செய் "DROP TABLE IF EXISTS qacamam", [];
தளம்_செய் "CREATE TABLE qacamam (மதிப்பு DECIMAL(20,4))", [];
தளம்_செய் "INSERT INTO qacamam VALUES (?)", [0.1];
தளம்_செய் "INSERT INTO qacamam VALUES (?)", [0.2];
தளம்_வினா "SELECT SUM(மதிப்பு) AS மொத்தம் FROM qacamam", [], கூட்டல்;
அச்சு "0.1 + 0.2 = " & கூட்டல்[0].மொத்தம்
      & " — exactly 0.3? " & (கூட்டல்[0].மொத்தம் == 0.3);

// A number bound to an INT key: MySQL coerces the text, so this must find it.
தளம்_வினா "SELECT peyar FROM pativukaL WHERE id = ?", [1], முதலாவது;
அச்சு "int key by number: " & நீளம்(முதலாவது) & " row(s)";

// A VARCHAR holding digits stays a string; a DECIMAL comes back a number.
தளம்_வினா "SELECT CAST('1500' AS CHAR) AS உரையானது,
                  CAST(1500 AS DECIMAL(10,2)) AS எண்ணானது", [], வகைகள்;
அச்சு "varchar -> " & வகை(வகைகள்[0].உரையானது)
      & ", decimal -> " & வகை(வகைகள்[0].எண்ணானது);

// NULL round trips as இன்மை rather than as an empty string.
தளம்_வினா "SELECT NULL AS ஒன்றுமில்லை", [], காலி;
அச்சு "null -> " & வகை(காலி[0].ஒன்றுமில்லை);

// A DATE column arrives as ISO text, which sorts chronologically.
தளம்_வினா "SELECT naaL FROM pativukaL WHERE id = ?", [1], நாளது;
அச்சு "date -> " & நாளது[0].naaL & " (" & வகை(நாளது[0].naaL) & ")";

// The injection payload reaches the driver bound, so it matches nothing and
// the table is still there afterwards.
தளம்_வினா "SELECT peyar FROM pativukaL WHERE peyar = ?",
          ["'; DROP TABLE pativukaL; --"], தாக்குதல்;
தளம்_வினா "SELECT COUNT(*) AS எண்ணிக்கை FROM pativukaL", [], எஞ்சியது;
அச்சு "injection matched " & நீளம்(தாக்குதல்) & " row(s); table still holds "
      & எஞ்சியது[0].எண்ணிக்கை;

தளம்_பிரி மைசீகுல்;
அச்சு "";
அச்சு "பிரிந்தது (disconnected)";
