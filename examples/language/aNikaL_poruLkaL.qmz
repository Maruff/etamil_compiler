// அணிகள் மற்றும் பொருள்கள் — arrays and records
//
// அணி is a column: ordered, read by position.
// பொருள் is a row: named fields, read by name.
// An array of records is therefore a table.

இறக்கு "../../nUlakam/aNi.qmz";
இறக்கு "../../nUlakam/kaNiqam.qmz";

// அணி — a column of values
விலைகள் = [1200, 450, 8900, 3300, 75];
அச்சு "விலைகள்      : " & விலைகள்;
அச்சு "எத்தனை       : " & நீளம்(விலைகள்);
அச்சு "மொத்தம்      : " & கூட்டு(விலைகள்);
அச்சு "மிகப்பெரியது : " & மதிப்பு(மிகப்பெரியது(விலைகள்));
அச்சு "தலைகீழ்      : " & தலைகீழ்(விலைகள்);
அச்சு "";

// பொருள் — a row
//
// Careful with field names: a word that is already a keyword is stored under
// its token name, so {நிலுவை: 1} becomes the field "Outstanding" and a
// string lookup of "நிலுவை" will not find it. Compound names like
// நிலுவைத்_தொகை are ordinary identifiers and are stored as written.
வாடிக்கையாளர் = {பெயர்: "ராஜா", ஊர்: "சென்னை", கடன்_வரம்பு: 50000};
அச்சு "வாடிக்கையாளர்: " & வாடிக்கையாளர்.பெயர் & ", " & வாடிக்கையாளர்.ஊர்;

// Fields can be updated, and new ones added
வாடிக்கையாளர்.கடன்_வரம்பு = 75000;
வாடிக்கையாளர்.நிலுவைத்_தொகை = 12500;
அச்சு "வரம்பு: " & வாடிக்கையாளர்.கடன்_வரம்பு
      & ", நிலுவை: " & வாடிக்கையாளர்.நிலுவைத்_தொகை;
அச்சு "";

// An array of records is a table
கணக்குகள் = [
    {பெயர்: "ராஜா",   நிலுவைத்_தொகை: 12500},
    {பெயர்: "தேவி",   நிலுவைத்_தொகை: 0},
    {பெயர்: "குமார்", நிலுவைத்_தொகை: 47300}
];

அச்சு "நிலுவை உள்ளவர்கள்:";
ஒவ்வொரு கணக்கு இல் கணக்குகள் {
    (கணக்கு.நிலுவைத்_தொகை > 0) எனில் {
        அச்சு "  " & கணக்கு.பெயர் & " — " & கணக்கு.நிலுவைத்_தொகை;
    }
}

// புலம்_எடு pulls one column out of the rows
நிலுவைகள் = புலம்_எடு(கணக்குகள், "நிலுவைத்_தொகை");
அச்சு "";
அச்சு "நிலுவைத் தொகுப்பு: " & நிலுவைகள்;
அச்சு "மொத்த நிலுவை    : " & கூட்டு(நிலுவைகள்);

// Iterating a record yields its field names
அச்சு "";
அச்சு "வாடிக்கையாளர் புலங்கள்:";
ஒவ்வொரு புலம் இல் வாடிக்கையாளர் {
    அச்சு "  " & புலம் & " = " & வாடிக்கையாளர்[புலம்];
}
