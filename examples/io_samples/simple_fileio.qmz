// கோப்பு உள்ளீடு/வெளியீடு — file input and output
//
// Self-contained: it writes the file it later reads, so it runs from a
// clean checkout without needing any data file to be present.

கோப்பு_திற "data.txt", "write";
கோப்பு_எழுது "data.txt", "125000";
கோப்பு_மூடு "data.txt";

// Read it back
எண் வருவாய்;
கோப்பு_படி "data.txt", வருவாய்;
அச்சு "கோப்பிலிருந்து வருவாய்: " & வருவாய்;

// Text read from a file is coerced when used as a number
வரி = வருவாய் * 10%;
அச்சு "வரி (10%): " & வரி;

// Write a result out
கோப்பு_திற "output.txt", "write";
கோப்பு_எழுது "output.txt", "வரி = " & வரி;
கோப்பு_மூடு "output.txt";

அச்சு "output.txt எழுதப்பட்டது";
