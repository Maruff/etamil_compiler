// திட்டம் சங்கமம் — one project, end to end
//
// Every directory in nUlakam that touches a project, used together on a single
// job. The point is not any one calculation — each has its own tests — but that
// they compose, and that the same underlying facts reach control, the ledger
// and the financial statements without being re-keyed.
//
// The chain:
//
//   the work breakdown            qittam/pakuppu
//   three-point estimates         itar/mUZRuppuLLi
//   the critical path             qittam/pAqY
//   real dates                    nAtkAtti/vElYnAL
//   the risk register             itar/itar
//   the budget and its reserves   qittam/kattuppAtu
//   timesheets, costed            vaLam/vaLam, vaLam/nEraqqAL
//   posted to the ledger          vaLam/paqivu
//   earned value                  qittam/Ittu_maqippu
//   revenue                       varuvAy/muZZERRam
//   the contract's position       varuvAy/iruppukaL, varuvAy/oppanqac_celavu
//
// It ends where a project like this usually ends: a cost performance index of
// 0.75 implies an estimate at completion above the contract price, and the
// contract is onerous. Ind AS 37 then wants the whole remaining loss today,
// while Ind AS 115 goes on recognising revenue as the work is done. Both are
// right, and a business that sees only one of them is surprised twice.

இறக்கு "../../nUlakam/qittam/pakuppu.qmz";
இறக்கு "../../nUlakam/qittam/kattuppAtu.qmz";
இறக்கு "../../nUlakam/qittam/pAqY.qmz";
இறக்கு "../../nUlakam/qittam/Ittu_maqippu.qmz";
இறக்கு "../../nUlakam/itar/itar.qmz";
இறக்கு "../../nUlakam/itar/mUZRuppuLLi.qmz";
இறக்கு "../../nUlakam/nAtkAtti/vElYnAL.qmz";
இறக்கு "../../nUlakam/vaLam/vaLam.qmz";
இறக்கு "../../nUlakam/vaLam/nEraqqAL.qmz";
இறக்கு "../../nUlakam/vaLam/paqivu.qmz";
இறக்கு "../../nUlakam/varuvAy/muZZERRam.qmz";
இறக்கு "../../nUlakam/varuvAy/iruppukaL.qmz";
இறக்கு "../../nUlakam/varuvAy/oppanqac_celavu.qmz";

அச்சு "═══ திட்டம் சங்கமம் — an ERP implementation, end to end ═══";
அச்சு "";

// =========================================================================
// 1. வேலைப் பகுப்பு — what the work is
// =========================================================================

கணுக்கள் = [
    கணு_ஆக்கு("S",   "",   "திட்டம் சங்கமம்",        1000000),
    கணு_ஆக்கு("S1",  "S",  "வடிவமைப்பு",              200000),
    கணு_ஆக்கு("S2",  "S",  "கட்டமைப்பு",              600000),
    கணு_ஆக்கு("S2a", "S2", "அடிப்படை அமைப்பு",        200000),
    கணு_ஆக்கு("S2b", "S2", "பயன்பாட்டு உருவாக்கம்",   400000),
    கணு_ஆக்கு("S3",  "S",  "தரவு இடமாற்றம்",          200000)
];

அச்சு "── 1. வேலைப் பகுப்பு ──";
அச்சு "  வேலைத் தொகுப்புகள் : " & நீளம்(வேலைத்_தொகுப்புகள்(கணுக்கள்));
அச்சு "  மொத்தம்            : " & உள்_கூட்டல்(கணுக்கள், "S");
அச்சு "  நூறு விதி சரியா    : " & நூறு_விதி_சரியா(கணுக்கள், "S");
அச்சு "";

// =========================================================================
// 2. மூன்றுப் புள்ளி மதிப்பீடு — how long, and how sure
// =========================================================================
//
// The durations that go into the network are the beta means. What a single
// number cannot carry is the spread, and that is what decides the date the
// business can actually promise.

வடிவமைப்பு = மதிப்பு(முப்புள்ளி_ஆக்கு(8, 10, 18));
கட்டமைப்பு = மதிப்பு(முப்புள்ளி_ஆக்கு(18, 20, 28));
இடமாற்றம் = மதிப்பு(முப்புள்ளி_ஆக்கு(6, 8, 10));
கடும்_பாதை = [வடிவமைப்பு, கட்டமைப்பு, இடமாற்றம்];

அச்சு "── 2. மூன்றுப் புள்ளி மதிப்பீடு ──";
அச்சு "  வடிவமைப்பு (8/10/18) : " & பீட்டா_சராசரி(வடிவமைப்பு) & " நாட்கள்";
அச்சு "  கட்டமைப்பு (18/20/28): " & பீட்டா_சராசரி(கட்டமைப்பு) & " நாட்கள்";
அச்சு "  இடமாற்றம்  (6/8/10)  : " & பீட்டா_சராசரி(இடமாற்றம்) & " நாட்கள்";
அச்சு "  பாதைச் சராசரி        : " & பாதை_சராசரி(கடும்_பாதை) & " நாட்கள்";
அச்சு "  பாதை விலகல்          : " & மதிப்பு(பாதை_விலகல்(கடும்_பாதை));
அச்சு "  சராசரியில் முடியும் நிகழ்தகவு : "
      & மதிப்பு(இலக்கு_நிகழ்தகவு(பாதை_சராசரி(கடும்_பாதை), கடும்_பாதை)) & "%";
தொண்ணூறு = மதிப்பு(நம்பிக்கை_காலம்(90, கடும்_பாதை));
அச்சு "  90% நம்பிக்கைக் காலம் : " & தொண்ணூறு["காலம்"] & " நாட்கள்  (இருப்பு "
      & தொண்ணூறு["கால_இருப்பு"] & ")";
அச்சு "  → சராசரியைச் சொல்வது நாணயம் சுண்டுவதற்குச் சமம்.";
அச்சு "";

// =========================================================================
// 3. கடுமையான பாதை — the critical path
// =========================================================================

செயல்கள் = [
    செயல்_ஆக்கு("A", பீட்டா_சராசரி(வடிவமைப்பு), []),
    செயல்_ஆக்கு("B", பீட்டா_சராசரி(கட்டமைப்பு), ["A"]),
    செயல்_ஆக்கு("D", 15, ["A"]),
    செயல்_ஆக்கு("C", பீட்டா_சராசரி(இடமாற்றம்), ["B", "D"])
];

வலை = மதிப்பு(வலையைக்_கணக்கிடு(செயல்கள்));
அச்சு "── 3. கடுமையான பாதை ──";
அச்சு "  திட்டக் காலம் : " & வலை.திட்ட_காலம் & " நாட்கள்";
அச்சு "  கடுமையானவை   : " & நீளம்(கடுமையானவை(வலை)) & " செயல்கள்";
அச்சு "  D இன் மிதப்பு : " & பெறு_புலம்(வலை.செயல்கள், "D", "மிதப்பு") & " நாட்கள்";
அச்சு "";

// =========================================================================
// 4. நாட்காட்டி — turning a duration into dates
// =========================================================================

நாட்காட்டி = நாட்காட்டி_ஆக்கு([0, 6], ["2026-05-01", "2026-08-15"]);
அட்டவணை = மதிப்பு(பணி_அட்டவணை("2026-04-01", வலை.திட்ட_காலம், நாட்காட்டி));

அச்சு "── 4. நாட்காட்டி ──";
அச்சு "  தொடக்கம்      : " & அட்டவணை["தொடக்கம்"] & "  ("
      & வாரநாள்_பெயர்(வாரநாள்(அட்டவணை["தொடக்கம்"])) & ")";
அச்சு "  முடிவு        : " & அட்டவணை["முடிவு"] & "  ("
      & வாரநாள்_பெயர்(வாரநாள்(அட்டவணை["முடிவு"])) & ")";
அச்சு "  வேலை நாட்கள்  : " & அட்டவணை["வேலை_நாட்கள்"];
அச்சு "  மொத்த நாட்கள் : " & அட்டவணை["மொத்த_நாட்கள்"]
      & "  ← வார விடுமுறைகளும் விடுமுறைகளும் சேர்த்து";
அச்சு "";

// =========================================================================
// 5. இடர்ப் பதிவேடு — and where the contingency reserve comes from
// =========================================================================

இடர்கள் = [
    இடர்_ஆக்கு("R1", "விற்பனையாளர் தாமதம்", 30, 200000, "அச்சுறுத்தல்", "பாலமுரளி"),
    இடர்_ஆக்கு("R2", "அளவு மாற்றம்",        20, 150000, "அச்சுறுத்தல்", "நிரஞ்சனா"),
    இடர்_ஆக்கு("R3", "முன்கூட்டிய முடிவு",   25,  80000, "வாய்ப்பு",     "ஸ்வேதா")
];

தற்செயல் = தற்செயல்_இருப்பைக்_கணக்கிடு(இடர்கள்);
மேலாண்மை = மேலாண்மை_இருப்பைக்_கணக்கிடு(1000000, 5);

அச்சு "── 5. இடர்ப் பதிவேடு ──";
அச்சு "  அச்சுறுத்தல்கள் : " & வகையால்_எதிர்பார்ப்பு(இடர்கள், "அச்சுறுத்தல்");
அச்சு "  வாய்ப்புகள்     : " & வகையால்_எதிர்பார்ப்பு(இடர்கள், "வாய்ப்பு");
அச்சு "  தற்செயல் இருப்பு : " & தற்செயல் & "  ← அச்சுறுத்தல்களிலிருந்து மட்டும்";
அச்சு "  மேலாண்மை இருப்பு : " & மேலாண்மை & "  ← கொள்கை விழுக்காடு, பதிவேட்டிலிருந்து அல்ல";
அச்சு "";

// =========================================================================
// 6. நிதி — the budget
// =========================================================================

தொகுதி = நிதித்_தொகுதி_ஆக்கு(1000000, தற்செயல், மேலாண்மை);
அச்சு "── 6. நிதி ──";
அச்சு "  அடிப்படை          : " & தொகுதி.அடிப்படை_நிதி;
அச்சு "  அளவீட்டு அடிப்படை : " & அளவீட்டு_அடிப்படை(தொகுதி);
அச்சு "  அனுமதித்த நிதி    : " & அனுமதித்த_நிதி(தொகுதி);
அச்சு "";

// =========================================================================
// 7. நேரத்தாள் — actual cost, from hours and rates
// =========================================================================

விகிதங்கள் = [
    விகிதப்_பதிவு("E1", 800, "2026-04-01", ""),
    விகிதப்_பதிவு("E2", 500, "2026-04-01", "")
];

தாள் = [
    நேர_உள்ளீடு("E1", "2026-04-06", "S1",  180, மெய்),
    நேர_உள்ளீடு("E2", "2026-04-20", "S1",  280, மெய்),
    நேர_உள்ளீடு("E2", "2026-05-11", "S2a", 200, மெய்)
];

கணக்கிட்டது = மதிப்பு(தாளைக்_கணக்கிடு(தாள், விகிதங்கள்));
அச்சு "── 7. நேரத்தாள் ──";
அச்சு "  மொத்த மணிகள் : " & கணக்கிட்டது["மொத்த_மணிகள்"];
அச்சு "  மொத்தச் செலவு : " & கணக்கிட்டது["மொத்தத்_தொகை"];
அச்சு "  S1 : " & பணிக்கு_மொத்தம்(கணக்கிட்டது["உள்ளீடுகள்"], "S1")["தொகை"];
அச்சு "  S2a: " & பணிக்கு_மொத்தம்(கணக்கிட்டது["உள்ளீடுகள்"], "S2a")["தொகை"];
அச்சு "";

// =========================================================================
// 8. பேரேடு — posted, and read back
// =========================================================================

நடப்பு = நடப்புக்_கணக்குக்_குறி("SNG", "ALL");
ஏடு = [];
ஏடு = மதிப்பு(பதிவிடு(ஏடு, உழைப்புப்_பதிவு(1, "2026-04-30", "உழைப்பு — ஏப்ரல்",
                                             நடப்பு, "PAYROLL",
                                             கணக்கிட்டது["மொத்தத்_தொகை"])));
ஏடு = மதிப்பு(பதிவிடு(ஏடு, பொருள்_பதிவு(2, "2026-05-15", "உரிமப் பொருட்கள்",
                                           நடப்பு, "STORES", 16000)));

உண்மைச்_செலவு = ஈட்டிய_செலவு(ஏடு, நடப்பு);
அச்சு "── 8. பேரேடு ──";
அச்சு "  நடப்புக் கணக்கு : " & நடப்பு;
அச்சு "  உண்மைச் செலவு (AC) : " & உண்மைச்_செலவு & "  ← பேரேட்டிலிருந்து, விரிதாளிலிருந்து அல்ல";
ஒப்பீடு = செலவை_ஒப்பிடு(ஏடு, நடப்பு, கணக்கிட்டது["மொத்தத்_தொகை"]);
அச்சு "  நேரத்தாளுடன் வேறுபாடு : " & ஒப்பீடு["வேறுபாடு"]
      & "  ← உரிமப் பொருட்கள், நேரத்தாளில் இல்லாதவை";
அச்சு "";

// =========================================================================
// 9. ஈட்டு மதிப்பு — control
// =========================================================================
//
// Earned value credits *scope*, by a completion rule. S1 is finished, so 0/100
// credits all of it; S2a has started and not finished, so 50/50 credits half.

ஈட்டியது = ஈட்டிய_மதிப்பு(200000, முறை_0_100(மெய்))
            + ஈட்டிய_மதிப்பு(200000, முறை_50_50(மெய், பொய்));
திட்டமிட்டது = 420000;

நிலை = மதிப்பு(நிலவரம்(திட்டமிட்டது, ஈட்டியது, உண்மைச்_செலவு, 1000000));

அச்சு "── 9. ஈட்டு மதிப்பு ──";
அச்சு "  திட்டமிட்டது  (PV) : " & திட்டமிட்டது;
அச்சு "  ஈட்டியது      (EV) : " & ஈட்டியது;
அச்சு "  உண்மைச் செலவு (AC) : " & உண்மைச்_செலவு;
அச்சு "  கணக்கியல் வேறுபாடு : " & கணக்கியல்_வேறுபாடு(திட்டமிட்டது, உண்மைச்_செலவு)
      & "  ← சாதகம் எனத் தோன்றுகிறது";
அச்சு "  செலவு வேறுபாடு (CV): " & நிலை.செலவு_வேறுபாடு & "  ← ஆனால் பாதகம்";
அச்சு "  கால வேறுபாடு   (SV): " & நிலை.கால_வேறுபாடு;
அச்சு "  CPI : " & நிலை.செலவுத்_திறன் & "    SPI : "
      & வட்டமிடு(நிலை.காலத்_திறன், 4);
அச்சு "  முடிவில் மதிப்பீடு (EAC) : " & வட்டமிடு(நிலை.முடிவில்_மதிப்பீடு, 2);
அச்சு "  → இரண்டு வாசிப்புகள் அளவில் அல்ல, திசையில் மாறுபடுகின்றன.";
அச்சு "";

// =========================================================================
// 10. வருவாய் — Ind AS 115, on the same costs
// =========================================================================
//
// The contract sells for 12,50,000. Revenue uses cost-to-cost against the
// *revised* total cost — the estimate at completion earned value just produced.
//
// Control and recognition then report the **same** percentage, and not by
// coincidence. An estimate at completion derived as BAC ÷ CPI is
// BAC × AC ÷ EV, so cost-to-cost progress AC ÷ EAC reduces to EV ÷ BAC — the
// earned value percent complete, exactly. The two measures agree precisely
// because one was built from the other.
//
// They part company the moment the estimate at completion is re-built from the
// bottom up instead of scaled by CPI, which is what a project in trouble
// eventually does. Then the same facts give two percentages, each correct
// under its own standard, and the difference has to be explained rather than
// reconciled away.

ஒப்பந்த_மதிப்பு = 1250000;
திருத்திய_செலவு = நிலை.முடிவில்_மதிப்பீடு;

வருவாய்_நிலை = மதிப்பு(வருவாய்_நிலவரம்(ஒப்பந்த_மதிப்பு, உண்மைச்_செலவு,
                                          திருத்திய_செலவு, 0));

அச்சு "── 10. வருவாய் (Ind AS 115) ──";
அச்சு "  ஒப்பந்த மதிப்பு      : " & ஒப்பந்த_மதிப்பு;
அச்சு "  திருத்திய மொத்தச் செலவு : " & வட்டமிடு(திருத்திய_செலவு, 2);
அச்சு "  செலவு-க்கு-செலவு முன்னேற்றம் : " & வருவாய்_நிலை["முன்னேற்றம்"];
அச்சு "  இதுவரை வருவாய்       : " & வருவாய்_நிலை["இதுவரை_வருவாய்"];
அச்சு "  எதிர்பார்க்கும் விளிம்பு : " & வருவாய்_நிலை["எதிர்பார்க்கும்_விளிம்பு"];
அச்சு "  → கட்டுப்பாட்டுக்கு " & வட்டமிடு(ஈட்டியது * 100 / 1000000, 2)
      & "% நிறைவு; வருவாய்க்கும் "
      & வட்டமிடு(வருவாய்_நிலை["முன்னேற்றம்"] * 100, 2) & "%.";
அச்சு "     EAC = BAC ÷ CPI எனும்போது இரண்டும் ஒன்றே — ஒன்றிலிருந்து";
அச்சு "     மற்றொன்று கட்டப்பட்டதால். கீழிருந்து மேலாக மறுமதிப்பீடு";
அச்சு "     செய்தால் மட்டுமே அவை பிரியும்.";
அச்சு "";

// =========================================================================
// 11. ஒப்பந்த நிலை — the balance sheet, and the loss
// =========================================================================

விலைப்பட்டியலிட்டது = 300000;
நிலைமை = ஒப்பந்த_நிலை("SNG", வருவாய்_நிலை["இதுவரை_வருவாய்"], விலைப்பட்டியலிட்டது);

எஞ்சிய_வருவாய் = ஒப்பந்த_மதிப்பு - வருவாய்_நிலை["இதுவரை_வருவாய்"];
எஞ்சிய_செலவு = திருத்திய_செலவு - உண்மைச்_செலவு;
தவிர்க்க_இயலாதது = தவிர்க்க_முடியாத_செலவு(எஞ்சிய_செலவு, 9999999);
நட்டம் = நட்டக்_கணக்கு(எஞ்சிய_வருவாய், தவிர்க்க_இயலாதது,
                        நிலைமை["ஒப்பந்தச்_சொத்து"]);

அச்சு "── 11. ஒப்பந்த நிலை ──";
அச்சு "  ஒப்பந்தச் சொத்து : " & நிலைமை["ஒப்பந்தச்_சொத்து"]
      & "  ← அங்கீகரித்த வருவாய் விலைப்பட்டியலைத் தாண்டியது";
அச்சு "  எஞ்சிய வருவாய்   : " & எஞ்சிய_வருவாய்;
அச்சு "  எஞ்சிய செலவு     : " & வட்டமிடு(எஞ்சிய_செலவு, 2);
அச்சு "  நட்டம் தருமா     : " & நட்டம்["நட்டமா"];
அச்சு "  மொத்த நட்டம்     : " & நட்டம்["மொத்த_நட்டம்"];
அச்சு "  சொத்துக் குறைவு  : " & நட்டம்["குறைவு"];
அச்சு "  ஒதுக்கீடு        : " & நட்டம்["ஒதுக்கீடு"]
      & "  ← சொத்து முழு நட்டத்தையும் உறிஞ்சியது";
அச்சு "  → Ind AS 37: முதலில் சொத்தைக் குறை, பிறகு மீதிக்கு ஒதுக்கு.";
அச்சு "     இங்கே மீதி இல்லை; முழு நட்டமும் இப்போதே அங்கீகரிக்கப்பட்டது.";
அச்சு "";

அச்சு "═══ முடிவு ═══";
அச்சு "CPI 0.75 என்பது ஒரு விகிதம் அல்ல; அது ஒப்பந்த விலையை மீறும்";
அச்சு "முடிவில் மதிப்பீடு, அதனால் வரும் ஒரு நட்ட ஒதுக்கீடு.";
அச்சு "ஒரே உண்மைகள் — மணிகளும் விகிதங்களும் — கட்டுப்பாட்டையும்,";
அச்சு "பேரேட்டையும், நிதி அறிக்கைகளையும் மறுபதிவின்றி அடைகின்றன.";
