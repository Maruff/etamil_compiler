// கணக்கியல் — a full accounting cycle
//
// Chart of accounts, GST-bearing transactions, double-entry posting, then
// the three statements — all in eTamil.

இறக்கு "../../nUlakam/kaNakkiyal/kaNakkukaL.qmz";
இறக்கு "../../nUlakam/kaNakkiyal/pErEtu.qmz";
இறக்கு "../../nUlakam/kaNakkiyal/vari.qmz";
இறக்கு "../../nUlakam/kaNakkiyal/aRikkYkaL.qmz";

// --- Chart of accounts ---
கணக்குகள் = [
    மதிப்பு(கணக்கு_ஆக்கு("1000", "வங்கி",          வகை_சொத்து(),   "நடப்பு")),
    மதிப்பு(கணக்கு_ஆக்கு("1100", "வாங்குநர்கள்",    வகை_சொத்து(),   "நடப்பு")),
    மதிப்பு(கணக்கு_ஆக்கு("2000", "விற்பனையாளர்கள்", வகை_பொறுப்பு(), "நடப்பு")),
    மதிப்பு(கணக்கு_ஆக்கு("2100", "வணிகவரி கட்டுப்பாடு", வகை_பொறுப்பு(), "நடப்பு")),
    மதிப்பு(கணக்கு_ஆக்கு("3000", "மூலதனம்",        வகை_பங்கு(),    "பங்கு")),
    மதிப்பு(கணக்கு_ஆக்கு("4000", "விற்பனை",        வகை_வருவாய்(),  "இயக்கம்")),
    மதிப்பு(கணக்கு_ஆக்கு("5000", "வாடகை",          வகை_செலவு(),    "இயக்கம்")),
    மதிப்பு(கணக்கு_ஆக்கு("5100", "பொருள் கொள்முதல்", வகை_செலவு(),   "இயக்கம்"))
];

பேரேடு = [];

// --- Opening capital: ₹5,00,000 into the bank ---
தொடக்கம் = பரிவர்த்தனை_ஆக்கு("JV001", "2026-04-01", "தொடக்க மூலதனம்", [
    பற்று_வரிசை("1000", 500000),
    வரவு_வரிசை("3000", 500000)
]);
பேரேடு = மதிப்பு(பதிவிடு(பேரேடு, தொடக்கம்));

// --- A credit sale of ₹2,00,000 + 18% GST ---
விற்பனை = விற்பனை_பரிவர்த்தனை("INV001", "2026-04-05", "மென்பொருள் சேவை",
                                "1100", "4000", "2100", 200000, 18);
பேரேடு = மதிப்பு(பதிவிடு(பேரேடு, விற்பனை));

// --- A credit purchase of ₹50,000 + 18% GST ---
கொள்முதல் = கொள்முதல்_பரிவர்த்தனை("BILL001", "2026-04-08", "பொருள் கொள்முதல்",
                                    "2000", "5100", "2100", 50000, 18);
பேரேடு = மதிப்பு(பதிவிடு(பேரேடு, கொள்முதல்));

// --- Rent paid from the bank ---
வாடகை = பரிவர்த்தனை_ஆக்கு("JV002", "2026-04-10", "அலுவலக வாடகை", [
    பற்று_வரிசை("5000", 45000),
    வரவு_வரிசை("1000", 45000)
]);
பேரேடு = மதிப்பு(பதிவிடு(பேரேடு, வாடகை));

// --- The customer pays ₹1,50,000 on account ---
பெறுதல் = பணம்_பெறு("RCT001", "2026-04-20", "வாடிக்கையாளர் பணம்",
                      "1000", "1100", 150000);
பேரேடு = மதிப்பு(பதிவிடு(பேரேடு, பெறுதல்));

// --- An unbalanced entry is refused ---
தவறான = பரிவர்த்தனை_ஆக்கு("JV999", "2026-04-30", "சமநிலை இல்லாதது", [
    பற்று_வரிசை("5000", 1000),
    வரவு_வரிசை("1000", 900)
]);
விளைவு = பதிவிடு(பேரேடு, தவறான);
(தவறா(விளைவு)) எனில் {
    அச்சு "✓ சமநிலையற்ற பரிவர்த்தனை மறுக்கப்பட்டது";
    அச்சு "";
}

// --- The statements ---
இருப்பாய்வு_அச்சிடு(இருப்பாய்வு(பேரேடு, கணக்குகள்));
அச்சு "";
வருமான_அறிக்கை_அச்சிடு(வருமான_அறிக்கை(பேரேடு, கணக்குகள்));
அச்சு "";
இருப்புநிலை_அச்சிடு(இருப்புநிலை(பேரேடு, கணக்குகள்));
