# out/ is what ships; the TypeScript sources and tests are not needed at runtime.
src/**
test/**
tsconfig.json
.eslintrc.json
.github/**
node_modules/**
out/**/*.map
**/*.tsbuildinfo

# bin/, runtime/ and fonts/ are deliberately absent from this list: the
# compiler, the standard library and the eTamil font are what the VSIX carries,
# and excluding any of them would ship an extension that still has to ask for
# something to be installed before it works.

# Not read by anything. kw.txt and kw-tamil.txt are keyword dumps from 0.4.0,
# superseded by src/generated/language-data.ts, which is generated from the
# lexer; .gitignore is about this working tree and means nothing inside a VSIX.
.gitignore
kw.txt
kw-tamil.txt

# Belt and braces. The release archives are extracted to a temp directory
# outside the repository now, but this directory shipped 576 files inside every
# VSIX once and the cost of naming it here is nothing.
.package-downloads
